    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="#//TokenDatatype">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                 &#xA;  &lt;m:formal-name xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;>Part Name&lt;/m:formal-name>&#xA;                 &#xA;  &lt;m:description xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;>A textual label that uniquely identifies the part's semantic type.&lt;/m:description>&#xA;              &#xA;"/>
