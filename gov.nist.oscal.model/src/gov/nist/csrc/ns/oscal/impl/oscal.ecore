  <eClassifiers xsi:type="ecore:EClass" name="SystemId">
    <eAnnotations>
      <details key="appinfo" value="&#xA;              &#xA;  &lt;m:formal-name xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;>System Identification&lt;/m:formal-name>&#xA;              &#xA;  &lt;m:description xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;>&#xA;    A &#xA;    &lt;a href=&quot;https://pages.nist.gov/OSCAL/concepts/identifier-use/#human-oriented&quot; xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>human-oriented&lt;/a>&#xA;    , &#xA;    &lt;a href=&quot;https://pages.nist.gov/OSCAL/concepts/identifier-use/#globally-unique&quot; xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>globally unique&lt;/a>&#xA;     identifier with &#xA;    &lt;a href=&quot;https://pages.nist.gov/OSCAL/concepts/identifier-use/#cross-instance&quot; xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>cross-instance&lt;/a>&#xA;     scope that can be used to reference this system identification property elsewhere in &#xA;    &lt;a href=&quot;https://pages.nist.gov/OSCAL/concepts/identifier-use/#scope&quot; xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>this or other OSCAL instances&lt;/a>&#xA;    . When referencing an externally defined &#xA;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>system identification&lt;/code>&#xA;    , the &#xA;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>system identification&lt;/code>&#xA;     must be used in the context of the external / imported OSCAL instance (e.g., uri-reference). This string should be assigned &#xA;    &lt;a href=&quot;https://pages.nist.gov/OSCAL/concepts/identifier-use/#consistency&quot; xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>per-subject&lt;/a>&#xA;    , which means it should be consistently used to identify the same system across revisions of the document.&#xA;  &lt;/m:description>&#xA;           &#xA;"/>
    </eAnnotations>
