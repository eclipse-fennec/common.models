    <eStructuralFeatures xsi:type="ecore:EAttribute" name="class" eType="#//TokenDatatype">
      <eAnnotations>
        <details key="appinfo" value="&#xA;                 &#xA;  &lt;m:formal-name xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;>Part Class&lt;/m:formal-name>&#xA;                 &#xA;  &lt;m:description xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;>&#xA;    A textual label that provides a sub-type or characterization of the part's &#xA;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>name&lt;/code>&#xA;    . This can be used to further distinguish or discriminate between the semantics of multiple parts of the same control with the same &#xA;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>name&lt;/code>&#xA;     and &#xA;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;>ns&lt;/code>&#xA;    .&#xA;  &lt;/m:description>&#xA;              &#xA;"/>
