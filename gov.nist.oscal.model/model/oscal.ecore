    <eStructuralFeatures xsi:type="ecore:EAttribute" name="componentUuid" lowerBound="1" eType="#//UUIDDatatype">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#10;                 &#10;  &lt;b xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;Component Universally Unique Identifier Reference&lt;/b&gt;&#10;  : A machine-oriented identifier reference to the component that is implementing a given control.&#10;" />
      </eAnnotations>
      <eAnnotations>
        <details key="appinfo" value="&#10;                 &#10;  &lt;m:formal-name xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;&gt;Component Universally Unique Identifier Reference&lt;/m:formal-name&gt;&#10;                 &#10;  &lt;m:description xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;&gt;&#10;    A &#10;    &lt;a href=&quot;https://pages.nist.gov/OSCAL/concepts/identifier-use/#machine-oriented&quot; xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;machine-oriented&lt;/a&gt;&#10;     identifier reference to the &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;component&lt;/code&gt;&#10;     that is implementing a given control.&#10;  &lt;/m:description&gt;&#10;              &#10;" />
