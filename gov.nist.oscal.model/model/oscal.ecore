  <eClassifiers xsi:type="ecore:EDataType" name="RelationshipType" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#10;                       &#10;  &lt;b xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;Mapping Entry Relationship&lt;/b&gt;&#10;  : The relationship type for the mapping entry, which describes the relationship between the effective requirements of the specified source and target sets in the context of the matching-rationale method globaly defined in the provenance unless overwritten locally in the  map. The relationship type and the matching-rationale must be used together. However, more than one matching-rationale method may apply to a source and target pair. &#10;" />
    </eAnnotations>
    <eAnnotations>
      <details key="appinfo" value="&#10;                       &#10;  &lt;m:formal-name xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;&gt;Mapping Entry Relationship&lt;/m:formal-name&gt;&#10;                       &#10;  &lt;m:description xmlns:m=&quot;http://csrc.nist.gov/ns/oscal/metaschema/1.0&quot;&gt;&#10;    The relationship type for the mapping entry, which describes the relationship between the effective requirements of the specified source and target sets in the context of the &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;matching-rationale&lt;/code&gt;&#10;     method globaly defined in the &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;provenance&lt;/code&gt;&#10;     unless overwritten locally in the &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt; map&lt;/code&gt;&#10;    . The &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;relationship&lt;/code&gt;&#10;     type and the &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;matching-rationale&lt;/code&gt;&#10;     must be used together. However, more than one &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;matching-rationale&lt;/code&gt;&#10;     method may apply to a &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;source&lt;/code&gt;&#10;     and &#10;    &lt;code xmlns=&quot;http://csrc.nist.gov/ns/oscal/1.0&quot;&gt;target&lt;/code&gt;&#10;     pair. &#10;  &lt;/m:description&gt;&#10;                    &#10;" />
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="relationship_._type" />
      <details key="baseType" value="TokenDatatype" />
    </eAnnotations>
