-resourceonly: true
-include: ${.}/buildpath.bnd	
mavendeps: ${sjoin;\n; ${template;-maven-dependencies;${@}}}

-includeresource: \
	template/workspace.bnd=resources/template/workspace.bnd,\
	{template/fennecEMFCommonModels.maven=resources/template/fennecEMFCommonModels.maven}	
	
Provide-Capability: \
	${fennec-base}

fennec-base:\
    bnd.library;\
        bnd.library     = fennecEMFCommonModels; \
        path            = template
        
Bundle-Name: Fennec EMF Common Models Workspace Library
Bundle-Description: Workspace library (fennecEMFCommonModels) for the external standard models of common.models. The Fennec-own models moved to eclipse-fennec/fennec.models (library fennecEMFModels).