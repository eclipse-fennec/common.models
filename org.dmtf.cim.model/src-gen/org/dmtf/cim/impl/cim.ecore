      <details key="override.Antecedent.Description" value="The database system that is responsible for the database."/>
      <details key="override.Dependent" value="CIM_CommonDatabase REF"/>
      <details key="override.Dependent.Description" value="The database."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The CIM_AssociatedDatabaseSystem association identifies the database system that is responsible for the database."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_ADSLModem" eSuperTypes="#//CIM_DSLModem">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.10.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Modems"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,DeviceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The ADSLModem class represents Modems of the DSL type = ADSL, Asymmetric Digital Subscriber Line."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NoiseMargin" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="Units" value="Tenths of Decibels"/>
        <details key="PUnit" value="decibel * 10^-1"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Noise Margin of this Modem with respect to its received signal, in tenths of dB."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LineAttenuation" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="Units" value="Tenths of Decibels"/>
        <details key="Gauge" value="true"/>
        <details key="PUnit" value="decibel * 10^-1"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Measured difference in the total power transmitted by the peer Modem and the total power received by this Modem. This value is measured in tenths of dB."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LineState" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;4&quot;,&quot;8&quot;,&quot;32&quot;]"/>
        <details key="Values" value="[&quot;No Defect&quot;,&quot;Loss Of Framing&quot;,&quot;Loss Of Signal&quot;,&quot;Loss Of Power&quot;,&quot;Loss Of Signal Quality&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Status indicates the current state of the connection (line). The property holds a bit map that describes the possible conditions. For example, &#xA;1) No Defect - There are no defects on the line; &#xA;2) Loss Of Framing - ATUR failure due to the inability to receive a valid frame; &#xA;4) Loss Of Signal - ATUR failure due to the inability to receive a signal; &#xA;8) Loss Of Power - ATUR failure due to loss of power; &#xA;32) Loss Of Signal Quality - Loss of Signal Quality is declared when the NoiseMargin falls below the minimum NoiseMargin, or the bit-error-rate exceeds 10^-7."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TotalOutputPower" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="Units" value="Tenths of Decibels"/>
        <details key="Gauge" value="true"/>
        <details key="PUnit" value="decibel * 10^-1"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Measured total output power (in tenths of dB) transmitted by this Modem."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MaxDataRate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="Units" value="Bits per Second"/>
        <details key="PUnit" value="bit / second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates the maximum currently attainable data rate for the Modem. This value will be equal to or greater than the current line rate."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_AccessLabelReader" eSuperTypes="#//CIM_AssociatedLabelReader">
