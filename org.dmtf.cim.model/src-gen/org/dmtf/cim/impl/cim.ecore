          <details key="Values" value="[&quot;Computer System&quot;,&quot;Front-end Computer System&quot;,&quot;Peer Computer System&quot;,&quot;Back-end Computer System&quot;,&quot;Front-end Port&quot;,&quot;Back-end Port&quot;,&quot;Volume&quot;,&quot;Extent&quot;,&quot;Disk Drive&quot;,&quot;Arbitrary LUs&quot;,&quot;Remote Replica Group&quot;,&quot;Computer System Rate&quot;,&quot;Front-end Computer System Rate&quot;,&quot;Peer Computer System Rate&quot;,&quot;Back-end Computer System Rate&quot;,&quot;Front-end Port Rate&quot;,&quot;Back-end Port Rate&quot;,&quot;Volume Rate&quot;,&quot;Extent Rate&quot;,&quot;Disk Drive Rate&quot;,&quot;Arbitrary LUs Rate&quot;,&quot;Remote Replica Group Rate&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
          <details key="ModelCorrespondence" value="[&quot;CIM_BlockStatisticsManifest.ElementType&quot;,&quot;CIM_BlockStatisticsManifest.RateElementType&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The type of elements whose statistics the BlockStatisticsManifest will filter."/>
