        <details key="cimType" value="string"/>
        <details key="Deprecated" value="[&quot;CIM_SharedCredential.InstanceID&quot;]"/>
        <details key="Key" value="true"/>
        <details key="MaxLen" value="256"/>
        <details key="Propagated" value="CIM_SharedSecretService.SystemName"/>
      </eAnnotations>
