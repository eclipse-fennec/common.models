      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The PostOfficeBox property specifies the PO box by which the person will receive physical postal delivery. If present, the property value is part of the object's postal address."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PreferredDeliveryMethod"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
