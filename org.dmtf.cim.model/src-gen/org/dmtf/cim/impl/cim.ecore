  <eClassifiers xsi:type="ecore:EClass" name="CIM_InSegment" eSuperTypes="#//CIM_InLogicalNetwork">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Deprecated" value="[&quot;CIM_MemberOfCollection&quot;]"/>
      <details key="Aggregation" value="true"/>
      <details key="Version" value="2.7.0"/>
      <details key="UMLPackagePath" value="CIM::Network::ProtocolEndpoints"/>
      <details key="override.Collection" value="CIM_LANSegment REF"/>
      <details key="override.Collection.Deprecated" value="[&quot;CIM_MemberOfCollection.Collection&quot;]"/>
      <details key="override.Collection.Aggregate" value="true"/>
      <details key="override.Collection.Max" value="1"/>
      <details key="override.Collection.Description" value="The LANSegment that groups the LANEndpoint instances."/>
      <details key="override.Member" value="CIM_LANEndpoint REF"/>
