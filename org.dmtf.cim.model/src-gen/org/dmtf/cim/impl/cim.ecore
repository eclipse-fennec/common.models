        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Idenfier for the log that is requested to be cleared."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="InstallSoftwareFromURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
