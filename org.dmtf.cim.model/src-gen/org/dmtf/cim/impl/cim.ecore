        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The underlying storage for the target elements (the replicas) will be drawn from TargetPools if specified, otherwise the allocation is implementation specific. If target elements are supplied, this parameter shall be NULL.supplied, this parameter shall be NULL. &#xA;If TargetPools supplied, TargetPool shall be NULL."/>
        </eAnnotations>
      </eParameters>
