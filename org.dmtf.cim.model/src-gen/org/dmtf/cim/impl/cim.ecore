  <eClassifiers xsi:type="ecore:EClass" name="CIM_IPEncapsulationManagementService"
      eSuperTypes="#//CIM_Service">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.52.0"/>
      <details key="UMLPackagePath" value="CIM::Network"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The service has a set of extrinsic methods to control the creation and removal of the instances required to create an IP encapsulation gateway also known as an IP Tunnel gateway.."/>
    </eAnnotations>
    <eOperations name="AddIPEncapsulationInterface" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Creates an instance of CIM_IPEncapsulationInterface that is used in IP Tunnel gateways. The method also creates a set of CIM_IPProtocolEndpoints and optionally a set of CIM_EncapsulationMappingSettingData instances."/>
      </eAnnotations>
      <eParameters name="TargetSystem" eType="#//CIM_System">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_System REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="reference to a system or network. The supported target interfaces for a CIM_IPEncapsulationInterface class or subclass"/>
        </eAnnotations>
      </eParameters>
      <eParameters name="EncapsulationGateway" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string"/>
          <details key="EmbeddedInstance" value="CIM_IPEncapsulationInterface"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A required string containing an embedded instance of the class or subclass of CIM_IPEncapsulationInterface describes the initial configuration of the resulting CIM_IPEncapsulationInterface instance. The populated properties of the embedded instance should not contain key properties, and any key property values may be ignored"/>
        </eAnnotations>
      </eParameters>
      <eParameters name="PAIPEndpoint" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string"/>
          <details key="EmbeddedInstance" value="CIM_IPProtocolEndpoint"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="string containing an embedded instance of the class or subclass of CIM_IPProtocolEndpoint that describes the initial configuration of a CIM_IPProtocolEndpoint that is on the provider network. The populated properties of the embedded instance should not contain key properties, and any key property values may be ignored."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="CAIPEndpoint" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string"/>
          <details key="EmbeddedInstance" value="CIM_IPProtocolEndpoint"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="string containing an embedded instances of the class or subclass of CIM_IPProtocolEndpoint that describes the initial configuration of an CIM_IPProtocolEndpoint that is on the customer network. The populated properties of the embedded instance should not contain key properties, and any key property values may be ignored."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="EncapsulationMapping" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string[]"/>
          <details key="EmbeddedInstance" value="CIM_EncapsulationMappingSettingData"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="array of strings containing embedded instances of the class or subclass of CIM_EncapsulationMappingSettingData that describes entries in a mapping table used by the encapsulation gateway to provide the encapsulation header information used by the gateway. The populated properties of the embedded CIM_EncapsulationMappingSettingData instances should not contain key properties, and any key property values may be ignored."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ResultingInterface" eType="#//CIM_IPEncapsulationInterface">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_IPEncapsulationInterface REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="If the creation of the CIM_IPEncapsulationInterface is successful, the instance of the class CIM_IPEncapsulationInterface that represents the instantiated instance of CIM_IPEncapsulationInteface is returned."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="a ConcreteJob instance is returned if the execution of the method is asynchronous"/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="AddIPEncapsulationMappings" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Adds a set of IPEncapuslationMappings used to configure an IP Tunnel."/>
      </eAnnotations>
      <eParameters name="TargetInterface" eType="#//CIM_IPEncapsulationInterface">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_IPEncapsulationInterface REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the IPEncapsulationInterface instance to associate the mapping."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="EncapsulationMappings" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string[]"/>
          <details key="EmbeddedInstance" value="CIM_EncapsulationMappingSettingData"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="array of strings containing embedded instances of the class or subclass of CIM_EncapsulationMappingSettingData that describes entries in a mapping table used by the encapsulation interface to provide the encapsulation header for the resultant IIPEncapsulationInterface. The populated properties of the embedded CIM_EncapsulationMappingSettingData instances should not contain key properties, and any key property values may be ignored."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="If the method is executed asyncronously an reference to CIM_ConcreteJob is returned"/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="RemoveIPEncapsulationInterface" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Method to remove an IPEncapsulationInterface and any associated CIM_ProtocolEndpoints or CIM_SettingData."/>
      </eAnnotations>
      <eParameters name="Gateway" eType="#//CIM_IPEncapsulationInterface">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_IPEncapsulationInterface REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A reference to the gateway that is to be removed."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="If the method is excuted asynchronously a reference to a ConcreteJob instance is returned."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="RemoveIPEncapsulationMappings" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Successful execution of the RemoveIPEncapsulationMappings removes the instances referenced in the methods EncapsulationMapping parameter"/>
      </eAnnotations>
      <eParameters name="EncapsulationMappings" unique="false" upperBound="-1" eType="#//CIM_EncapsulationMappingSettingData">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_EncapsulationMappingSettingData REF[]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="An array of references to the set of CIM_EncapsulationMappingSettingData instances that shall be removed."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="If the method is executed asynchronously then a reference to a CIM_ConcreteJob instance is returned"/>
        </eAnnotations>
      </eParameters>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_IPLoopback" eSuperTypes="#//CIM_IPProtocolEndpoint">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.51.0"/>
      <details key="UMLPackagePath" value="CIM::Network"/>
      <details key="override.ElementName" value="string"/>
      <details key="override.ElementName.Description" value="The Interface name for the Loopback interface. This property allows each instance to define a user-friendly name in addition to the Name property which is a key properties in this class. Element Name may be a copy of the Name property but the class provider may add additional indentifing information to the Name property to assure it is a unique instance when forming the key."/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A loopback interface is a virtual Layer 3 interface typically found in an Ethernet Switch or router that has a single endpoint that is always up. Packets that are transmitted over a loopback interface are immediately received by this interface."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_IPSubinterface" eSuperTypes="#//CIM_IPProtocolEndpoint">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.51.0"/>
      <details key="UMLPackagePath" value="CIM::Network"/>
      <details key="override.ElementName" value="string"/>
      <details key="override.ElementName.Description" value="The Interface name for the IPSubinterface. This property allows each instance to define a user-friendly name in addition to the Name property which is a key properties in this class. Element Name may be a copy of the Name property but the class provider may add additional indentifing information to the Name property to assure it is a unique instance when forming the key."/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Configuration properties for an Ethernet switch or router subinterface. A IPSubinterface allows the router to route traffic on a single port as if it were part of multiple separate IP subnets. The parent Interface is configured as a trunk port and the connection is is divided by encapsulating each frame with VLAN information."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="EncapsulationType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;..&quot;,&quot;32767..65535&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;Dot1Q&quot;,&quot;DMTF reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_IPSubinterface.EncapsulationValue&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="1- Other, If other there should be a description or type set in the OtherEncapsulationType property.&#xA;2- Dot1Q Configures IEEE 802.1Q VLAN encapsulation on the IPSubinterface (VLANId), if selected the the EncapsulationValue property should be set to a value between 2 and 4093."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ParentInterface" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
        <details key="Reference" value="CIM_EthernetPort"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This property contains a reference to the port (instance of CIM_EthernetPort) that this IPSubinterface is associated with. Each non-null value of the ParentInterfaceID property shall be formated as a URI per RFC3986 and should be a WBEM URI (DSP0207)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="EncapsulationValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_IPSubinterface.EncapsulationType&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Depending on the value of EncapsulationType property this EncapsulationValue should contain the configuration value for the encapsulation."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="OtherEncapsulationType"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_IPSubinterface.EncapsulationType&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A string that describes the encapsulation type when a well defined value is not available and EncapsulationType has the value &quot;Other&quot;."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_IPsecSAEndpoint" eSuperTypes="#//CIM_SecurityAssociationEndpoint">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.8.0"/>
      <details key="UMLPackagePath" value="CIM::Network::IPsec"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="IPsecSAEndpoints are types of SecurityAssociationEndpoints representing both negotiated and static SAs that correspond to AH, ESP, or IPCOMP transforms."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SPI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="SPI contains the Security Parameter Index of the SA. This value in string form may also be used in the key field 'Name' inherited from ServiceAccessPoint."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="InboundDirection" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="InboundDirection specifies whether the SA applies to inbound (TRUE) or outbound (FALSE) traffic."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="EncapsulationMode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;3&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Tunnel&quot;,&quot;Transport&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="EncapsulationMode indicates whether the IPsecSAEndpoint uses transport or tunnel encapsulation."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DFHandling" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Copy from Internal to External IP Header&quot;,&quot;Set DF Bit in External Header to 1&quot;,&quot;Set DF Bit in External Header to 0&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="DFHandling controls how the 'Don't Fragment' bit is managed by the IPsecSAEndpoint."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PFSInUse" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
