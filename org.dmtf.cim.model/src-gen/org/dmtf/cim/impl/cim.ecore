        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;XML&quot;,&quot;HTML&quot;,&quot;Binary&quot;,&quot;Executable&quot;,&quot;.hlp&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_HelpServiceAvailableToFile.OtherDocumentFormatDescription&quot;]"/>
      </eAnnotations>
