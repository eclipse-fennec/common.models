  <eClassifiers xsi:type="ecore:EClass" name="CIM_ExtentInDiskGroup" eSuperTypes="#//CIM_CollectedMSEs">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Aggregation" value="true"/>
      <details key="Version" value="2.10.0"/>
      <details key="UMLPackagePath" value="CIM::Device::DiskGroup"/>
      <details key="override.Collection" value="CIM_DiskGroup REF"/>
