        <details key="Values" value="[&quot;Completed with No Error&quot;,&quot;Not Supported&quot;,&quot;Failed&quot;,&quot;Timeout&quot;,&quot;Invalid Parameter&quot;,&quot;Invalid State&quot;,&quot;Incompatible Parameters&quot;,&quot;DMTF Reserved&quot;,&quot;Method Parameters Checked - Job Started&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Modifies virtual resource settings.&#xA;When applied to parts of a &quot;current&quot; virtual system configuration, as a side effect resources of the active virtual system may be modified."/>
      </eAnnotations>
      <eParameters name="ResourceSettings" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
