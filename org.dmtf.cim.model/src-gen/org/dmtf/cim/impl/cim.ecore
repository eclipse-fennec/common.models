        <details key="Deprecated" value="[&quot;CIM_ElementSettingData.SettingData&quot;,&quot;CIM_CollectionSetting.Setting&quot;]"/>
        <details key="Key" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this element is deprecated. Deprecated description: The Configuration object that groups the Settings and dependencies that are associated with the Collection."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
