    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ContainmentType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="Deprecated" value="[&quot;No value&quot;]"/>
