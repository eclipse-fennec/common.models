  <eClassifiers xsi:type="ecore:EClass" name="CIM_RemotePort" eSuperTypes="#//CIM_RemoteServiceAccessPoint">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.10.0"/>
      <details key="UMLPackagePath" value="CIM::Core::Service"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="RemotePort adds port information to the access data (such as IP Address) that is specified in and inherited from RemoteServiceAccessPoint. For example, using the additional properties in this class, you could indicate that UDP Port 123 is accessed at IP Address xyz. The IP Address would be specified in the inherited AccessInfo property, while the UDP Port number would be specified in the PortInfo property of this class."/>
    </eAnnotations>
