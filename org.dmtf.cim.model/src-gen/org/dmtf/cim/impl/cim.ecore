          <details key="documentation" value="BlockStatisticsManifestCollection from which the BlockStatisticsManifests will be removed."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Manifests" unique="false" upperBound="-1" eType="#//CIM_BlockStatisticsManifest">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_BlockStatisticsManifest REF[]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="List of BlockStatisticsManifests to be removed from the BlockStatisticsManifestCollection."/>
