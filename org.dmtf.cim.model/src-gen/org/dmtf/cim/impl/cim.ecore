      <details key="override.Dependent.Description" value="The SpanningTree in which a TransparentBridgingService is nested."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This association identifies the spanning tree in which a forwarding database (TransparentBridgingService) is nested."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_RelatedTransparentBridgingService"
      eSuperTypes="#//CIM_ServiceSAPDependency">
