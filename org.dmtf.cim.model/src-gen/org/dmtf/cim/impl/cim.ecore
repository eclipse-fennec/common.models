        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="UserContactTemplate is a template for the desired UserContact to be created."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Identity" eType="#//CIM_Identity">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_Identity REF"/>
          <details key="Required" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A Reference to a existing CIM_Identity instance to be associated to the newly created CIM_UserContact instance."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="UserContact" eType="#//CIM_UserContact">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_UserContact REF"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the instance of CIM_UserContact created when the method returns a value of 0. This value shall be NULL if the method returns a value other than 0."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="GetAccounts" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
