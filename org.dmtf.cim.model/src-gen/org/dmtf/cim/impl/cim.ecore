      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="PFSInUse indicates whether perfect forward secrecy is required when refreshing keys."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_InBGPPeerGroup" eSuperTypes="#//CIM_CollectedMSEs">
