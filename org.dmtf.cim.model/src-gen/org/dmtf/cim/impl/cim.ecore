        <details key="MappingStrings" value="[&quot;MIF.DMTF|Process Information|001.16&quot;]"/>
        <details key="PUnit" value="byte * 2^10"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The number of KiloBytes of real data space used by the process."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="RealStack" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
