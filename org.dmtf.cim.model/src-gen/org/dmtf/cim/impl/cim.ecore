      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A true value indicates that logical capacity alerts governed by LogicalCapacityWarningAlertThreshold and LogicalCapacityCriticalAlertThreshold will be issued."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LogicalCapacityWarningAlertThreshold"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="Units" value="Percentage"/>
        <details key="MinValue" value="0"/>
        <details key="MaxValue" value="100"/>
        <details key="PUnit" value="percent"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Logical capacity threshold after which a warning alert will betriggered. Readable and writable. Must be an integer value between 0 and 100."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LogicalCapacityCriticalAlertThreshold"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
