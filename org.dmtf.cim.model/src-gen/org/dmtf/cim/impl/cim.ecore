        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;3&quot;,&quot;..&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Final&quot;,&quot;Experimental&quot;,&quot;DMTF Reserved&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The status of the schema."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_SystemIdentification" eSuperTypes="#//CIM_ManagedElement">
