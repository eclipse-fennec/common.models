      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Count of Link resets. This count is the number of LRs transmitted."/>
      </eAnnotations>
    </eStructuralFeatures>
