        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A reference to the other end of the synchronization association. For example, the target element. OtherElement can be a local or a remote element."/>
        </eAnnotations>
      </eParameters>
