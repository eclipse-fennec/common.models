          <details key="In" value="true"/>
          <details key="ValueMap" value="[&quot;2&quot;,&quot;3&quot;]"/>
          <details key="Values" value="[&quot;Supports&quot;,&quot;Installed&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The type of inquiry to be performed."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Recursive" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="boolean"/>
          <details key="In" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="False : Only report on elements directly contained in/attached to the given ManagedElement. &#xA;True : Report on all objects contained in/attached to the given ManagedElement."/>
        </eAnnotations>
