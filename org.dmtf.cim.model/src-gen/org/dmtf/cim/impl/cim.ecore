        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to source access point information. If NULL, service does not need access information to access the source elements."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetGroup" eType="#//CIM_ReplicationGroup">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ReplicationGroup REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Optionally, as an input, refers to a target group to use. As an output, refers to the created target group (i.e., the replica group). If a job is created, the target group may not be available immediately."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetGroupName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="As in parameter, the name of the group to be created. If the name is not supplied, the implementation may assign a group name and return it in this parameter."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetElements" unique="false" upperBound="-1" eType="#//CIM_LogicalElement">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_LogicalElement REF[]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A list of target storage objects which may be StorageVolumes or other storage objects. All the target elements shall be of the same type -- for example, all StorageVolumes."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetElementNames" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string[]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="An array of end user relevant names for the elements being created. If NULL, then a system supplied name is used. The value will be stored in the 'ElementName' property for the created elements."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetAccessPoint" eType="#//CIM_ServiceAccessPoint">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ServiceAccessPoint REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to target access point information. If NULL, service does not need access information to access the target element/group."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Consistency" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="uint16"/>
          <details key="ValueMap" value="[&quot;2&quot;,&quot;3&quot;,&quot;..&quot;,&quot;0x8000..&quot;]"/>
          <details key="Values" value="[&quot;No Consistency&quot;,&quot;Sequential Consistency&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Overrides the default group consistency."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ReplicationSettingData" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string"/>
          <details key="EmbeddedInstance" value="CIM_ReplicationSettingData"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="If provided, it overrides the default replication setting data for the given SyncType. If not provided, the management server uses the default replication setting data."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the job (may be NULL if job is completed)."/>
