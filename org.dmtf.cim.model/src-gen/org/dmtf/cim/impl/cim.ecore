      <details key="override.Dependent" value="CIM_WakeUpService REF"/>
      <details key="override.Dependent.Description" value="The wakeup Service that is provided on the Modem."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="WakeUpServiceOnModem defines where the WakeUpService is implemented. The Service can either employ a Modem or NetworkAdapter to receive a wakeup signal."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_WakeUpServiceOnNetworkAdapter" eSuperTypes="#//CIM_DeviceServiceImplementation">
