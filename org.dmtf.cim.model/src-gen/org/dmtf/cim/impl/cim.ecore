        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="erence to the access point instance to allow the service to access the OtherElement. If NULL, it is assumed the service does not need any access information or the element is local."/>
        </eAnnotations>
      </eParameters>
