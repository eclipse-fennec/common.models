      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="MaxRxFrameRate is the maximum receive frame rate achieved."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TxRate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
