      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="TxFrameRate is the instantaneous transmit frame rate."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="RxFrameRate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
