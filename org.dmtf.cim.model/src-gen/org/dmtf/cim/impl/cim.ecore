      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Confirm data written to the source elements has been replicated to the target elements. &#xA;This method is useful for asynchronous replication where data written to the source elements may not be replicated to the target elements right away. If 4096/0x1000 is returned, a ConcreteJob is started, a reference to which is returned in the Job output parameter."/>
      </eAnnotations>
      <eParameters name="Synchronized" eType="#//CIM_Synchronized">
