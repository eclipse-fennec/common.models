      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Numeric identifier for a switch port."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_SwitchPortDynamicForwarding" eSuperTypes="#//CIM_Dependency">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.7.0"/>
      <details key="UMLPackagePath" value="CIM::Network::SwitchingBridging"/>
      <details key="override.Antecedent" value="CIM_SwitchPort REF"/>
      <details key="override.Antecedent.Min" value="1"/>
      <details key="override.Antecedent.Description" value="The SwitchPort."/>
      <details key="override.Dependent" value="CIM_DynamicForwardingEntry REF"/>
      <details key="override.Dependent.Description" value="DynamicForwardingEntry of the forwarding database."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This association links a DynamicForwardingEntry and the SwitchPort to which the entry applies."/>
    </eAnnotations>
