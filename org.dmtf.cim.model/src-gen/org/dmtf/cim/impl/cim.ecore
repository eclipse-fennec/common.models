  <eClassifiers xsi:type="ecore:EClass" name="CIM_DNSGeneralSettingData" eSuperTypes="#//CIM_IPAssignmentSettingData">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.14.0"/>
      <details key="UMLPackagePath" value="CIM::Network::DNS"/>
      <details key="override.AddressOrigin" value="uint16"/>
      <details key="override.AddressOrigin.Description" value="AddressOrigin identifies the method by which the IP Address, Subnet Mask, and Gateway were assigned to the IPProtocolEndpoint. This is independent of the DNS configuration, thus this property has the value of 2 (&quot;Not Applicable&quot;)"/>
      <details key="override.AddressOrigin.ValueMap" value="[&quot;0..1&quot;,&quot;2&quot;,&quot;3..32767&quot;,&quot;32768..&quot;]"/>
      <details key="override.AddressOrigin.Values" value="[&quot;DMTF Reserved&quot;,&quot;Not Applicable&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
      <details key="keys" value="InstanceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The DNSGeneralSettingData class represents the system wide configuration options for the DNS client. Therefore, these configuration parameters are scoped to a computer system and are applicable to all of the network interfaces of the scoping system."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="AppendPrimarySuffixes"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="Write" value="true"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DNSProtocolEndpoint.AppendPrimarySuffixes&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether or not the client should automatically append the primary domain suffix to target names prior to attempting to resolve."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="AppendParentSuffixes" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="Write" value="true"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DNSProtocolEndpoint.AppendParentSuffixes&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether or not the client should automatically append the parent domain suffix to target names prior to attempting to resolve."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DNSSuffixesToAppend" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string[]"/>
        <details key="Write" value="true"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DNSProtocolEndpoint.DNSSuffixesToAppend&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="DNS suffixes to append when attempting to resolve a hostname."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_DNSSettingData" eSuperTypes="#//CIM_IPAssignmentSettingData">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.18.1"/>
      <details key="UMLPackagePath" value="CIM::Network::DNS"/>
      <details key="override.AddressOrigin" value="uint16"/>
      <details key="override.AddressOrigin.Description" value="AddressOrigin identifies the method by which the IP Address, Subnet Mask, and Gateway were assigned to the IPProtocolEndpoint. This is independent of the DNS configuration, thus this property has the value of 2 (&quot;Not Applicable&quot;)"/>
      <details key="override.AddressOrigin.ValueMap" value="[&quot;0..1&quot;,&quot;2&quot;,&quot;3..32767&quot;,&quot;32768..&quot;]"/>
      <details key="override.AddressOrigin.Values" value="[&quot;DMTF Reserved&quot;,&quot;Not Applicable&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
      <details key="keys" value="InstanceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="DNSSettingData defines the DNSconfiguration settings for a single IP network connection. With the exception of the the DNSServerAddresses and the hostname in use, the configuration of a DNSProtocolEndpoint is indicated by the properties of an associated instance of DNSSettingData."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DomainName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
        <details key="Write" value="true"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DNSProtocolEndpoint.DomainName&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The domain to use for this client connection."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="RequestedHostname" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
        <details key="Write" value="true"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DNSProtocolEndpoint.Hostname&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Hostname requested for this client connection."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="UseSuffixWhenRegistering"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DNSProtocolEndpoint.UseSuffixWhenRegistering&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether or not the suffix should be appended before registering the client name with the DNS server."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="RegisterThisConnectionsAddress"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DNSProtocolEndpoint.RegisterThisConnectionsAddress&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether or not this connection's address should be registered in DNS."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DNSServerAddresses" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string[]"/>
        <details key="Write" value="true"/>
        <details key="ArrayType" value="Ordered"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The DNS servers to contact. The array ordering correlates to the order in which the DNS servers will be contacted. The RemoteServiceAccessPoints associated with the DNSProtocolEndpoint with the value of the AccessContext property being &quot;DNS Server&quot; represent the actual DNS Servers being utilized by the DNS client."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DHCPOptionsToUse" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;8&quot;,&quot;14&quot;,&quot;17&quot;,&quot;18..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Domain Name Server&quot;,&quot;Host Name&quot;,&quot;Domain Name&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_DHCPProtocolEndpoint.OptionsReceived&quot;,&quot;CIM_DNSProtocolEndpoint.DHCPOptionsToUse&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="One or more DHCP options that the DNS client should utilise if they are returned during a DHCP bind operation."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_DynamicForwardingEntry" eSuperTypes="#//CIM_LogicalElement">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.7.0"/>
      <details key="UMLPackagePath" value="CIM::Network::SwitchingBridging"/>
      <details key="keys" value="SystemCreationClassName,SystemName,ServiceCreationClassName,ServiceName,CreationClassName,MACAddress"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A DynamicForwardingEntry represents an entry in the forwarding (filtering) database associated with the TransparentBridgingService. The entry is Weak to the Service as specified by TransparentBridgingDynamicForwarding."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SystemCreationClassName"
