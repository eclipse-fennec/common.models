        <details key="cimType" value="uint64"/>
        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The number of retried picks."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PutSuccesses" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
