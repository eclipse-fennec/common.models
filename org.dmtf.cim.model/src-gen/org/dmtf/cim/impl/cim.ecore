      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="FBSYFrames" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
