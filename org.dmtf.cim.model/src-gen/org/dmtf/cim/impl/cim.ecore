      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The scoping Process's ComputerSystem Name."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="OSCreationClassName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
