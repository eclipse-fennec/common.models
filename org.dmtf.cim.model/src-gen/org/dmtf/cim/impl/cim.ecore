        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The SCSIProtocolController instance representing the iSCSI Node that will be deleted."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_AcceptCredentialFrom" eSuperTypes="#//CIM_Dependency">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.8.0"/>
      <details key="UMLPackagePath" value="CIM::Policy"/>
      <details key="MappingStrings" value="[&quot;IPSP Policy Model.IETF|AcceptCredentialFrom&quot;]"/>
      <details key="override.Antecedent" value="CIM_CredentialManagementService REF"/>
      <details key="override.Antecedent.Description" value="The CredentialManagementService that is issuing the credential to be matched in the PacketFilterCondition."/>
      <details key="override.Antecedent.MappingStrings" value="[&quot;IPSP Policy Model.IETF|AcceptCredentialFrom.Antecedent&quot;]"/>
      <details key="override.Dependent" value="CIM_PacketFilterCondition REF"/>
      <details key="override.Dependent.Description" value="The PacketFilterCondition that associates the CredentialManagementService and any FilterLists/FilterEntries."/>
      <details key="override.Dependent.MappingStrings" value="[&quot;IPSP Policy Model.IETF|AcceptCredentialFrom.Dependent&quot;]"/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This association specifies that a credential management service (e.g., CertificateAuthority or Kerberos key distribution service) is to be trusted to certify credentials, presented at the packet level. The association defines an 'approved' CredentialManagementService that is used for validation. &#xA;&#xA;The use of this class is best explained via an example: &#xA;If a CertificateAuthority is specified using this association, and a corresponding X509CredentialFilterEntry is also associated with a PacketFilterCondition (via the relationship, FilterOfPacketCondition), then the credential MUST match the FilterEntry data AND be certified by that CA (or one of the CredentialManagementServices in its trust hierarchy). Otherwise, the X509CredentialFilterEntry is deemed not to match. If a credential is certified by a CredentialManagementService associated with the PacketFilterCondition through the AcceptCredentialFrom relationship, but there is no corresponding CredentialFilterEntry, then all credentials from the related service are considered to match."/>
    </eAnnotations>
  </eClassifiers>
