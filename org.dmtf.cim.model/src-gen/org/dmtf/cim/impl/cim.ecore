    <eOperations name="GetDefaultGroupPersistency" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6&quot;,&quot;..&quot;,&quot;0x8000..&quot;]"/>
        <details key="Values" value="[&quot;Success&quot;,&quot;Not Supported&quot;,&quot;Unknown&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;In Use&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method returns the default persistency for a newly created group."/>
      </eAnnotations>
      <eParameters name="DefaultGroupPersistency" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="uint16"/>
          <details key="Out" value="true"/>
          <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;..&quot;,&quot;0x8000..&quot;]"/>
          <details key="Values" value="[&quot;No default persistency&quot;,&quot;DMTF Reserved&quot;,&quot;Persistent&quot;,&quot;Not Persistent&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Default group persistency value."/>
