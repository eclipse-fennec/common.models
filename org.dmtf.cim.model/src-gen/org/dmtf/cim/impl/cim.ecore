        <details key="cimType" value="uint64"/>
        <details key="Units" value="KiloBytes"/>
        <details key="MappingStrings" value="[&quot;MIF.DMTF|Process Information|001.18&quot;]"/>
        <details key="PUnit" value="byte * 2^10"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The number of KiloBytes of virtual text space used by the process."/>
