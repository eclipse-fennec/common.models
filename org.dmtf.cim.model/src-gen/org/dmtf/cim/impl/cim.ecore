        <details key="Values" value="[&quot;Other&quot;,&quot;Host Name&quot;,&quot;IPv4 Address&quot;,&quot;IPv6 Address&quot;,&quot;IPX Address&quot;,&quot;DECnet Address&quot;,&quot;SNA Address&quot;,&quot;IPv4 Subnet Address&quot;,&quot;IPv6 Subnet Address&quot;,&quot;IPv4 Address Range&quot;,&quot;IPv6 Address Range&quot;,&quot;Dial String&quot;,&quot;Ethernet Address&quot;,&quot;Token Ring Address&quot;,&quot;URL&quot;,&quot;FQDN&quot;,&quot;User FQDN&quot;,&quot;DER ASN1 DN&quot;,&quot;DER ASN1 GN&quot;,&quot;Key ID&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_RemoteServiceAccessPoint.InfoFormat&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An enumeration indicating which of the formats for CIM_RemoteServiceAccessPoint.InfoFormat are supported by the Media Redirection Service."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
