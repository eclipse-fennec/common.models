        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_StorageExtent REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Serves as a guide to help the instrumentation determine which elements to return. It must be a member of one of the pools passed in. This may be NULL."/>
        </eAnnotations>
      </eParameters>
