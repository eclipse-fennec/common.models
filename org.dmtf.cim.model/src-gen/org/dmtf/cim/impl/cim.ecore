  <eClassifiers xsi:type="ecore:EClass" name="CIM_AssociatedSupplyVoltageSensor" eSuperTypes="#//CIM_AssociatedSensor">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
