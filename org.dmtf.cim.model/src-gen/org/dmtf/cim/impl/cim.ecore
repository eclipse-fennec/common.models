        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The number of attempted write operations."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="UnrecoverableWriteOperations"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
