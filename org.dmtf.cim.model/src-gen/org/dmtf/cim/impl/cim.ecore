    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SharingModeSupported" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
