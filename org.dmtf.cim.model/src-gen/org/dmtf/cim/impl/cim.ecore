      <details key="override.AccessInfo.Description" value="The host address."/>
      <details key="override.PortProtocol" value="uint16"/>
      <details key="override.PortProtocol.Description" value="A UDP port to which the traps/informs are sent."/>
      <details key="override.PortInfo" value="string"/>
