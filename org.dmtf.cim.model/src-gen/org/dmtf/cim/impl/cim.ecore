        <details key="cimType" value="boolean"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Set to true if consistency is enabled."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ConsistencyType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;2&quot;,&quot;..&quot;,&quot;0x8000..&quot;]"/>
        <details key="Values" value="[&quot;Sequentially Consistent&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates the consistency type used by the source and its associated target group."/>
