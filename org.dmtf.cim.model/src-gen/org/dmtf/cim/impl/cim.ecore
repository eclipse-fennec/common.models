  <eClassifiers xsi:type="ecore:EClass" name="CIM_MediaRedirectionCapabilities" eSuperTypes="#//CIM_RedirectionServiceCapabilities">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.22.0"/>
      <details key="UMLPackagePath" value="CIM::Network::MediaRedirection"/>
      <details key="keys" value="InstanceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="MediaRedirectionCapabilities describes the capabilities of the Media Redirection Service."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ConnectionModesSupported"
        unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;3&quot;,&quot;..&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Listen&quot;,&quot;Connect&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specified&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_MediaRedirectionSAP.ConnectionMode&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The connection mode used to configure the session. A value set to 2 = &quot;Listen&quot; shall indicate that the SAP will listen for a connection request from the remote Media redirection server. A CIM_BindsTo association to a CIM_ProtocolEndoint may be used to represent where the SAP is listening for the connection request. A value set to 3 = &quot;Connect&quot; shall indicate that the the SAP shall initiate the connection to the remote Media redirection server. A CIM_RemoteAccessAvailableToElement association to a CIM_RemoteServiceAccessPoint may be used to represent where the SAP shall connect to the remote Media redirection server."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DevicesSupported" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6&quot;,&quot;7&quot;,&quot;8&quot;,&quot;..&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;CIM_CDROMDrive&quot;,&quot;CIM_DiskDrive&quot;,&quot;CIM_DisketteDrive&quot;,&quot;CIM_DVDDrive&quot;,&quot;CIM_MagnetoOpticalDrive&quot;,&quot;CIM_TapDrive&quot;,&quot;CIM_WORMDrive&quot;,&quot;DMTF_ Reserved&quot;,&quot;Vendor_ Specified&quot;]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_MediaRedirectionCapabilities.MaxDevicesSupported&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An enumeration indicating the types of Media Devices which are supported by the Media Redirection Service. Note that each entry of this array is related to the entry in the MaxDevicesSupported array that is located at the same index."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MaxDevicesSupported" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_MediaRedirectionCapabilities.DevicesSupported&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An enumeration indicating the number of Media devices which are supported for the devices specified in the DevicesSupported array property. Note that each entry of this array is related to the entry in the DevicesSupported that is located at the same index."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MaxDevicesPerSAP" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_MediaRedirectionCapabilities.DevicesSupported&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An enumeration indicating the number of Media devices per MediaRedirection Session which are supported for the devices specified in the DevicesSupported array property. Note that each entry of this array is related to the engry in the DevicesSupported array that is located at the same index."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SAPCapabilitiesSupported"
        unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;..&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Modify SAP&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specified&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An enumeration indicating the whether instances of USBRedirectionSAPs already exist and whether whether SAPs can be created. A value set to 2 = &quot;Modify Timeouts&quot; shall indicate that the timeout parameters of instances of CIM_USBRedirectionSAP can be modified by applications using 'ModifyInstance'"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="InfoFormatsSupported" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
