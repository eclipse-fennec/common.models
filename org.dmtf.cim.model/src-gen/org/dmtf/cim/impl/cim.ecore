        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ProtocolEndpoint REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The ProtocolEndpoint instance. If an iSCSI Initiator Port is being modified this will be an IPProtocolEndpoint. If an iSCSI Target Port is being modified this will be a TCPProtocolEndpoint."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="CreateiSCSINode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
