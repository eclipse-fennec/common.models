      <details key="documentation" value="Service to define and manipulate virtual systems and their components"/>
    </eAnnotations>
    <eOperations name="AddResourceSettings" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;..&quot;,&quot;4096&quot;,&quot;4097..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Completed with No Error&quot;,&quot;Not Supported&quot;,&quot;Failed&quot;,&quot;Timeout&quot;,&quot;Invalid Parameter&quot;,&quot;DMTF Reserved&quot;,&quot;Method Parameters Checked - Job Started&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Adds resources to a virtual system configuration&#xA;.When applied to a &quot;state&quot; virtual system configuration, as a side effect resources are added to the active virtual system."/>
      </eAnnotations>
      <eParameters name="AffectedConfiguration" eType="#//CIM_VirtualSystemSettingData">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_VirtualSystemSettingData REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the affected virtual system configuration."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ResourceSettings" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string[]"/>
          <details key="EmbeddedInstance" value="CIM_ResourceAllocationSettingData"/>
          <details key="ArrayType" value="Indexed"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Array of strings each containing one embedded instance of class CIM_ResourceAllocationSettingData that describes the virtual aspects of a virtual resource to be added to the virtual system."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ResultingResourceSettings" unique="false" upperBound="-1"
          eType="#//CIM_ResourceAllocationSettingData">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ResourceAllocationSettingData REF[]"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
          <details key="ArrayType" value="Indexed"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Array of references to instances of class CIM_ResourceAllocationSettingData representing virtual aspects of the added virtual resources."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="If the operation is long running, then optionally a job may be returned. In this case, the instances of class CIM_ResourceAllocationSettingData representing the added resource settings are available via association CIM_ConreteComponent from the instance of class CIM_VirtualSystemSettingData representing the affected virtual system configuration."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="DefineSystem" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;..&quot;,&quot;4096&quot;,&quot;4097..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Completed with No Error&quot;,&quot;Not Supported&quot;,&quot;Failed&quot;,&quot;Timeout&quot;,&quot;Invalid Parameter&quot;,&quot;DMTF Reserved&quot;,&quot;Method Parameters Checked - Job Started&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Defines a virtual system.&#xA;Input that is not completely specified may be filled out with default values."/>
      </eAnnotations>
      <eParameters name="SystemSettings" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
