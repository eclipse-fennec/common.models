      <eParameters name="Zone" eType="#//CIM_Zone">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_Zone REF"/>
          <details key="Required" value="true"/>
        </eAnnotations>
