          <details key="documentation" value="The requirements for the element to maintain. This parameter should be a reference to a Setting or Profile appropriate to the element being created. ."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ElementType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="uint16"/>
          <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;3&quot;,&quot;..&quot;,&quot;32768..65535&quot;]"/>
          <details key="Values" value="[&quot;Unknown&quot;,&quot;StorageVolume&quot;,&quot;LogicalDisk&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Enumeration indicating the type of element being created or modified."/>
        </eAnnotations>
      </eParameters>
