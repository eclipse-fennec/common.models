        <details key="Values" value="[&quot;Success&quot;,&quot;Not Supported&quot;,&quot;Unspecified Error&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;Access_Denied&quot;,&quot;Not_Found&quot;,&quot;Already_Exists&quot;,&quot;Insufficient_Resources&quot;,&quot;DMTF_Reserved&quot;,&quot;Method_Reserved&quot;,&quot;Vendor_Reserved&quot;]"/>
