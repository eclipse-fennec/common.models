        <details key="Values" value="[&quot;CreateFileServer&quot;,&quot;DeleteFileServer&quot;,&quot;ModifyFileServer&quot;,&quot;AddIPInterface&quot;,&quot;ModifyIPInterface&quot;,&quot;DeleteIPInterface&quot;,&quot;CreateGoalSettings&quot;,&quot;Reserved&quot;,&quot;Vendor Defined&quot;]"/>
