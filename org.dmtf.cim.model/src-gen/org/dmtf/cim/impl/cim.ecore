        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;No value&quot;]"/>
        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The number of times that a fill word could not be deleted, when required. The Elasticity Buffer is defined in FC-AL. This event might cause data corruption and might indicate a configuration error or a device out of spec."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ReceiverTransmitterTimeout"
