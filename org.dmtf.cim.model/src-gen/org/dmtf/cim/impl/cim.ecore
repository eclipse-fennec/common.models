  <eClassifiers xsi:type="ecore:EClass" name="CIM_RunningOS" eSuperTypes="#//CIM_Dependency">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.6.0"/>
      <details key="UMLPackagePath" value="CIM::System::OperatingSystem"/>
      <details key="override.Antecedent" value="CIM_OperatingSystem REF"/>
      <details key="override.Antecedent.Max" value="1"/>
      <details key="override.Antecedent.Description" value="The OperatingSystem currently running on the ComputerSystem."/>
      <details key="override.Dependent" value="CIM_ComputerSystem REF"/>
      <details key="override.Dependent.Max" value="1"/>
      <details key="override.Dependent.Description" value="The ComputerSystem."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="RunningOS indicates the currently executing OperatingSystem. At most one OperatingSystem can execute at any time on a ComputerSystem. 'At most one' is specified, since the Computer System may not be currently booted, or its OperatingSystem may be unknown."/>
