        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The target of query, for example a rack or a chassis."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ClassTypes" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string[]"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
        </eAnnotations>
