      <details key="override.Antecedent.Description" value="The PhysicalExtent."/>
      <details key="override.Dependent" value="CIM_AggregatePSExtent REF"/>
      <details key="override.Dependent.Deprecated" value="[&quot;CIM_ProtectedExtentBasedOn.Dependent&quot;]"/>
      <details key="override.Dependent.Description" value="The AggregatePSExtent which is built on the PhysicalExtent."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This association is deprecated in lieu of ProtectedSpaceBasedOn, since PhysicalExtents and AggregatePSExtents are themselves deprecated. The association describes that AggregatePSExtents are BasedOn a single PhysicalExtent."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_AggregateRedundancyComponent" eSuperTypes="#//CIM_ExtentRedundancyComponent">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Deprecated" value="[&quot;CIM_ExtentRedundancyComponent&quot;]"/>
