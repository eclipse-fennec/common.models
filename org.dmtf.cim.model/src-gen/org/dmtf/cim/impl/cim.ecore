      <details key="UMLPackagePath" value="CIM::Device::SccExtents"/>
      <details key="override.Antecedent" value="CIM_ProtectedSpaceExtent REF"/>
      <details key="override.Antecedent.Deprecated" value="[&quot;CIM_CompositeExtentBasedOn.Antecedent&quot;]"/>
      <details key="override.Antecedent.Min" value="1"/>
      <details key="override.Antecedent.Description" value="The ProtectedSpaceExtent."/>
      <details key="override.Dependent" value="CIM_VolumeSet REF"/>
      <details key="override.Dependent.Deprecated" value="[&quot;CIM_CompositeExtentBasedOn.Dependent&quot;]"/>
      <details key="override.Dependent.Description" value="The VolumeSet which is built on the ProtectedSpace Extent."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This association is deprecated in lieu of CompositeExtentBasedOn, since VolumeSets and ProtectedSpaceExtents are themselves deprecated. The relationship describes that VolumeSets are BasedOn on one or more ProtectedSpaceExtents."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LBAsMappedByDecrementing"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="Deprecated" value="[&quot;CIM_CompositeExtentBasedOn.LBAsMappedByDecrementing&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="True if logical blocks in the ProtectedSpaceExtent are mapped in decrementing order. This property corresponds to the INCDEC value in the SCC-2 Volume Set PS_Extent Descriptor."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LBAMappingIncludesCheckData"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="Deprecated" value="[&quot;CIM_CompositeExtentBasedOn.LBAMappingIncludesCheckData&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="True if the logical block mapping algorithm includes check data bytes. This property corresponds to the NOCHKSKIP attribute in the SCC-2 Volume Set PS_Extent Descriptor."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_WakeUpServiceOnModem" eSuperTypes="#//CIM_DeviceServiceImplementation">
