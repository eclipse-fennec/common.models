      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6&quot;,&quot;..&quot;,&quot;4096&quot;,&quot;4097&quot;,&quot;4098&quot;,&quot;4099..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Job Completed with No Error&quot;,&quot;Not Supported&quot;,&quot;Unknown&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;In Use&quot;,&quot;DMTF Reserved&quot;,&quot;Method Parameters Checked - Job Started&quot;,&quot;Target is Not a Member of a StorageRedundancySet&quot;,&quot;Rebuild already in Progress&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
