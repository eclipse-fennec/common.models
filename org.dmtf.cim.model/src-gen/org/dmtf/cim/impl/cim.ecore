      <details key="Version" value="2.16.0"/>
      <details key="UMLPackagePath" value="CIM::User::Credential"/>
      <details key="override.Antecedent" value="CIM_CredentialManagementService REF"/>
      <details key="override.Antecedent.Deprecated" value="[&quot;CIM_ServiceAffectsElement.AffectingElement&quot;]"/>
      <details key="override.Antecedent.Max" value="1"/>
      <details key="override.Antecedent.Description" value="The credential management service."/>
