      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ReceiveCharsLost" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
