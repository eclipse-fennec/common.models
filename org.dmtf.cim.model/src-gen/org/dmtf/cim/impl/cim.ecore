  <eClassifiers xsi:type="ecore:EClass" name="CIM_VirtualSystemSnapshotService" eSuperTypes="#//CIM_Service">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.40.0"/>
