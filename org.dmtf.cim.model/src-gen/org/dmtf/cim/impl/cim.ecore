        <details key="ModelCorrespondence" value="[&quot;CIM_StorageConfigurationService.CreateOrModifyElementFromStoragePool(ElementType)&quot;,&quot;CIM_StorageConfigurationService.CreateOrModifyElementFromElements(ElementType)&quot;,&quot;CIM_StorageConfigurationService.CreateElementsFromStoragePools(ElementType)&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Enumeration indicating the type of storage elements that are supported by the associated StorageConfigurationService."/>
      </eAnnotations>
    </eStructuralFeatures>
