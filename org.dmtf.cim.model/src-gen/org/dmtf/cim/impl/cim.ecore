          <details key="Values" value="[&quot;SystemElement&quot;,&quot;SyncedElement&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="An array that specifies whether the local element can be the source or the target element of the copy operations. Possible values are: &#xA;SystemElement: the source element. &#xA;SyncedElement: the target element. &#xA;These designations correspond to the keys of the Synchronized association."/>
        </eAnnotations>
      </eParameters>
