        <details key="cimType" value="string[]"/>
        <details key="MaxLen" value="40"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The PostalCode property specifies the postal code for the role occupants. If this value is present it will be part of the object's postal address."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PostOfficeBox" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string[]"/>
        <details key="MaxLen" value="40"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The PostOfficeBox property specifies the PO box by which the role occupants will receive physical postal delivery. If present, the property value is part of the object's postal address."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PreferredDeliveryMethod"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
