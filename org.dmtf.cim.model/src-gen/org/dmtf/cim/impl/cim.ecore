      <details key="override.GroupComponent" value="CIM_AutonomousSystem REF"/>
      <details key="override.GroupComponent.Aggregate" value="true"/>
      <details key="override.GroupComponent.Max" value="1"/>
      <details key="override.GroupComponent.Description" value="The autonomous system."/>
      <details key="override.PartComponent" value="CIM_RoutingProtocolDomain REF"/>
      <details key="override.PartComponent.Description" value="The routing domain."/>
      <details key="keys" value="GroupComponent,PartComponent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This assocation connects an AutonomousSystem to the routing domains that it contains."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_SNMPTrapTarget" eSuperTypes="#//CIM_RemotePort">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.7.0"/>
      <details key="UMLPackagePath" value="CIM::Network::SNMP"/>
