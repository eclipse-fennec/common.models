      <details key="override.PortType.Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;ATA&quot;,&quot;SATA&quot;,&quot;SATA2&quot;,&quot;Vendor Reserved&quot;]"/>
      <details key="override.PortType.ModelCorrespondence" value="[&quot;CIM_NetworkPort.OtherNetworkPortType&quot;]"/>
