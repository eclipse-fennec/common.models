        <details key="documentation" value="Boolean indicating whether the DeliveryRetryAttempts property can be set by a client application."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DeliveryRetryIntervalIsSettable"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_IndicationService.DeliveryRetryInterval&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Boolean indicating whether the DeliveryRetryInterval property can be set by a client application."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SubscriptionRemovalActionIsSettable"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
