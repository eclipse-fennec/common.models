          <details key="documentation" value="A reference to the Zone that the ZoneAlias is to be added to."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ZoneAlias" eType="#//CIM_NamedAddressCollection">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_NamedAddressCollection REF"/>
