        <details key="Values" value="[&quot;InExtents&quot;,&quot;Single InPool&quot;,&quot;Multiple InPools&quot;,&quot;Storage Pool QoS Change&quot;,&quot;Storage Pool Capacity Expansion&quot;,&quot;Storage Pool Capacity Reduction&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
