        <details key="MappingStrings" value="[&quot;MIF.DMTF|Software Component Information|002.4&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The internal identifier for this compilation of SoftwareElement."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SerialNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
