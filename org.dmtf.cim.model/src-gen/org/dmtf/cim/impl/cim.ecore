  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_SerialInterface" eSuperTypes="#//CIM_ControlledBy">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.10.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Controller"/>
      <details key="override.Antecedent" value="CIM_SerialController REF"/>
      <details key="override.Antecedent.Description" value="The SerialController."/>
      <details key="override.NegotiatedDataWidth" value="uint32"/>
      <details key="override.NegotiatedDataWidth.Description" value="For the SerialInterface, NegotiatedDataWidth is the number of data bits to be transmitted, without stop bits or parity."/>
      <details key="override.NegotiatedDataWidth.Units" value="Bits"/>
      <details key="override.NegotiatedDataWidth.PUnit" value="bit"/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="SerialInterface is a ControlledBy relationship that indicates which Devices are accessed through the SerialController and describes the characteristics of this access."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NumberOfStopBits" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
