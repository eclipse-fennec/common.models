        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;]"/>
        <details key="Values" value="[&quot;Other&quot;,&quot;Unknown&quot;,&quot;Disabled&quot;,&quot;Enabled&quot;,&quot;Not Implemented&quot;]"/>
        <details key="MappingStrings" value="[&quot;MIF.DMTF|System Hardware Security|001.2&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An integer indicating whether a hardware-level password is enabled at the keyboard (value=4), preventing local input. Other values are: &quot;Disabled&quot; (3), &quot;Not Implemented&quot; (5), &quot;Other&quot; (1) and &quot;Unknown&quot; (2)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_LLDPEthernetPort" eSuperTypes="#//CIM_EthernetPort">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.34.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Ports"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,DeviceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This class describes the current LLDP configuration of an LLDP capable ethernet port."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ConfigPortVlanTxEnable"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2Xdot1ConfigPortVlanTxEnable&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This flag determines whether the IEEE 802.1 organizationally defined port VLAN TLV transmission is allowed on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ConfigManVidTxEnable" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2Xdot1ConfigManVidTxEnable&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This flag determines determines whether the IEEE 802.1 organizationally defined Management VID TLV transmission is allowed on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MessageTxInterval" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="30">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="MinValue" value="1"/>
        <details key="MaxValue" value="3600"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2MessageTxInterval&quot;]"/>
        <details key="PUnit" value="second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The interval at which LLDP frames are transmitted on behalf of this LLDP agent on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MessageTxHoldMultiplier"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="4">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint8"/>
        <details key="MinValue" value="2"/>
        <details key="MaxValue" value="100"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2MessageTxHoldMultiplier&quot;]"/>
        <details key="PUnit" value="second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value of this property is used, as a multiplier of MessageTxInterval, to determine the value of txTTL that is carried in LLDP frames transmitted by the LLDP agent on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ReinitDelay" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="2">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint8"/>
        <details key="MinValue" value="1"/>
        <details key="MaxValue" value="10"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2ReinitDelay&quot;]"/>
        <details key="PUnit" value="second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value of this property indicates the amount of delay from when adminStatus becomes disabled until reinitialization is attempted on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NotificationInterval" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="30">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="MinValue" value="5"/>
        <details key="MaxValue" value="3600"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2NotificationInterval&quot;]"/>
        <details key="PUnit" value="second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value of this property indicates the interval between transmission of LLDP notifications during normal transmission periods on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TxCreditMax" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="5">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint8"/>
        <details key="MinValue" value="1"/>
        <details key="MaxValue" value="100"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2TxCreditMax&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The maximum number of consecutive LLDPDUs that can be transmitted at any time on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MessageFastTx" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="1">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="MinValue" value="1"/>
        <details key="MaxValue" value="3600"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2MessageFastTx&quot;]"/>
        <details key="PUnit" value="second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The interval at which LLDP frames are transmitted on behalf of this LLDP agent during fast transmission period (e.g. when a new neighbor is detected) on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TxFastInit" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="4">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint8"/>
        <details key="MinValue" value="1"/>
        <details key="MaxValue" value="8"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2TxFastInit&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The initial value used to initialize the variable which determines the number of transmissions that are made in fast transmission mode on this port."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DestMacAddress" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string[]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2DestMacAddress&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This array identifies individual or group MAC addresses that are in use by LLDP as destination MAC addresses on this port. Each MAC address is formatted as twelve hexadecimal digits (for example, &quot;010203040506&quot;), with each pair representing one of the six octets of the MAC address in &quot;canonical&quot; bit order. (Therefore, the Group address bit is found in the low order bit of the first character of the string.)"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PortConfigAdminStatus"
        unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint8[]"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;..&quot;]"/>
        <details key="Values" value="[&quot;txOnly&quot;,&quot;rxOnly&quot;,&quot;txAndRx&quot;,&quot;disabled&quot;,&quot;DMTF Reserved&quot;]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="MappingStrings" value="[&quot;MIB.IEEE|LLDP-EXT-DOT1-V2-MIB.lldpV2PortConfigAdminStatus&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_LLDPEthernetPort.DestMacAddress&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The administratively desired status of the local LLDP agent on this port.&#xA;&quot;txOnly&quot; indicates that the LLDP agent transmits LLDPframes on this port and it does not store any information about the remote systems connected.&#xA;&quot;rxOnly&quot; indicates that the LLDP agent receives, but it does not transmit LLDP frames on this port.&#xA;&quot;txAndRx&quot; indicates the LLDP agent transmits and receives LLDP frames on this port.&#xA;&quot;disabled&quot; indciates the LLDP agent does not transmit or receive LLDP frames on this port. If there is remote systems information which is received on this port and stored in other tables, before the port's PortConfigAdminStatus becomes disabled, then that information is deleted."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PortConfigNotificationEnable"
