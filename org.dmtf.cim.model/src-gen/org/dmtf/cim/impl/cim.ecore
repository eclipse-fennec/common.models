      <details key="Version" value="2.10.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Controller"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,DeviceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Note: The use of this class is deprecated in lieu of SCSIProtocolController. The latter reflects the protocol- related issues of SCSI interfaces, because these are not bus master-type Controllers.&quot; Deprecated description: Capabilities and management of the SCSIController."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ProtectionManagement" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
