        <details key="cimType" value="uint32"/>
        <details key="MinValue" value="1"/>
        <details key="MaxValue" value="65535"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|iSCSI-MIB.iscsiCxnCid&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The iSCSI Connection ID for this connection."/>
