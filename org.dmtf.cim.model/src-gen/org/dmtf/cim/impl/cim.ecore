      <details key="keys" value="InstanceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="NetworkPortCapabilities describes the capabilities supported for properties that are configurable in NetworkPort."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SpeedConfigurable" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"
        defaultValueLiteral="false">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_NetworkPortCapabilities.PortSpeedsSupported&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Boolean that indicates whether the Speed can be configured."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PortSpeedsSupported" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64[]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_NetworkPort.Speed&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="List of supported port speeds that can be configured on NetworkPort.Speed."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NetworkIDsConfigurable"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_NetworkPortSettings.NetworkIDs&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Boolean indicating whether the NetworkPort can be configured to connect to specific Networks."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NetworkIDsFormat" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;2&quot;,&quot;..&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Virtual Fabric ID&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_NetworkPortSettings.NetworkIDs&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The format that is expected to populate the NetworkIds for the associated NetworkPortSettings.list of supported LinkTechnologies of the NetworkPort is defined in the NetworkPortCapabilities."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LinkTechnologiesSupported"
        unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
