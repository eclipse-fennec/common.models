      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The TelexNumber property specifies the telex number, country code, and answerback code of a telex terminal for the organization."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ThumbnailLogo" unique="false"
