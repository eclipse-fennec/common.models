        <details key="documentation" value="If the EnabledCharacterDisplayModes property is set to 1, &quot;Other&quot; then free form string providing more information about the enabled mode. If not set to 1, this string has no meaning."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="CharacterDisplayMode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="Write" value="true"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;Console&quot;,&quot;Stream&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_TelnetProtocolEndpoint.OtherCharacterDisplayMode&quot;,&quot;CIM_TelnetProtocolEndpoint.EnabledCharacterDisplayModes&quot;]"/>
