        <details key="documentation" value="A URI (see RFC3986) that uniquely identifies this schema version. Note that this is a URI for iddentifying the schema version, not a URL for accessing it. For example, http://schemas.dmtf.org/wbem/cim-schema/2.35.0/."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="OwningOrganization" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
