          <details key="documentation" value="If provided, it overrides the default replication setting data for the given SyncType. For example, the intended CopyMethodology can be specified to determine if the copy operation is supported for the given source and target elements."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="SyncTypes" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
