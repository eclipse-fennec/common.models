    <eStructuralFeatures xsi:type="ecore:EAttribute" name="CRCErrors" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;CIM_FCPortStatistics.CRCErrors&quot;]"/>
        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: Number of times that the CRC in a frame does not match the CRC computed by the receiver."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="InvalidTransmissionWords"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;CIM_FCPortStatistics.InvalidTransmissionWords&quot;]"/>
        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The number of transmission words that had an 8b10b code violation in one or more of its characters, had a K28.5 in its second, third, or fourth character positions, or was an ordered set that had an incorrect Beginning Running Disparity."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="FramesTooShort" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;CIM_FCPortStatistics.FramesTooShort&quot;]"/>
        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The number of frames that were received that were shorter than 28 octets. The value of 28 is calculated based on an assumption of 24 header bytes plus 4 CRC bytes. The count does not include SOF/EOF bytes that are not data."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="FramesTooLong" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;CIM_FCPortStatistics.FramesTooLong&quot;]"/>
        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The number of frames that were received that were longer than 2140 octets. The value of 2140 is calculated based on an assumption of 24 header bytes plus 4 CRC bytes and 2112 bytes of payload."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ElasticityBufferUnderruns"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;No value&quot;]"/>
        <details key="Counter" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The number of times that a fill word could not be inserted, when required. The Elasticity Buffer is defined in FC-AL. This event might cause data corruption and might indicate a configuration error or that a device is out of spec."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ElasticityBufferOverruns"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
