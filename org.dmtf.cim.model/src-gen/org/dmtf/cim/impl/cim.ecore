        <details key="Values" value="[&quot;Completed with No Error&quot;,&quot;Not Supported&quot;,&quot;Unknown/Unspecified Error&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specified&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Transfers ownership of a CIM_OpaqueManagementData instance to the CIM_Identity instance referenced by the Identity parameter."/>
