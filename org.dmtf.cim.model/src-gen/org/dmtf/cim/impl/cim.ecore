        <details key="Deprecated" value="[&quot;CIM_UnsignedCredential.InstanceID&quot;]"/>
        <details key="Key" value="true"/>
        <details key="MaxLen" value="256"/>
        <details key="Propagated" value="CIM_PublicKeyManagementService.Name"/>
