      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Describes the format of the document when DocumentFormat= &quot;Other&quot; is specified."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_HelpServiceAvailableToFile" eSuperTypes="#//CIM_ServiceAvailableToElement">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.9.0"/>
      <details key="UMLPackagePath" value="CIM::System::Help"/>
      <details key="override.ServiceProvided" value="CIM_HelpService REF"/>
      <details key="override.ServiceProvided.Description" value="The Service that is available."/>
      <details key="override.UserOfService" value="CIM_LogicalFile REF"/>
      <details key="override.UserOfService.Description" value="The file that make use of this Service."/>
      <details key="keys" value="ServiceProvided,UserOfService"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_HelpServiceAvailableToFile indicates that the service is available for accessing the help file."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DocumentFormat" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
