      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method returns an array of storage objects that can form a storage tier. The selection criteria is based on the input parameters. The more input parameters, the narrower the search criteria. For example, it is possible to specify to return the candidate storage objects based on all storage extents of a storage pool, i.e. ConcreteComponents, that utilize solid state technology by supplying the appropriate InPools and TierSettingData."/>
      </eAnnotations>
      <eParameters name="InElements" unique="false" upperBound="-1" eType="#//CIM_LogicalElement">
