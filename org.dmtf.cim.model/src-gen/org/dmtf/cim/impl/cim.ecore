        <details key="cimType" value="uint64"/>
        <details key="MappingStrings" value="[&quot;FC-SWAPI.T11|PerformanceRates|1.SWAPI_STATS_LBL_TFPR&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_StatisticalData.SampleInterval&quot;]"/>
