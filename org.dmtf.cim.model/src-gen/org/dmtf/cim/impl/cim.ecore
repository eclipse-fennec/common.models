  <eClassifiers xsi:type="ecore:EClass" name="CIM_VolumeSetBasedOnPSExtent" eSuperTypes="#//CIM_BasedOn">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
