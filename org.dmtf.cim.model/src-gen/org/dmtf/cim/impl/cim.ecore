        <details key="Values" value="[&quot;Other&quot;,&quot;IPV4_ADDR&quot;,&quot;FQDN&quot;,&quot;USER_FQDN&quot;,&quot;IPV4_ADDR_SUBNET&quot;,&quot;IPV6_ADDR&quot;,&quot;IPV6_ADDR_SUBNET&quot;,&quot;IPV4_ADDR_RANGE&quot;,&quot;IPV6_ADDR_RANGE&quot;,&quot;DER_ASN1_DN&quot;,&quot;DER_ASN1_GN&quot;,&quot;KEY_ID&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_UnsignedPublicKey.PeerIdentity&quot;]"/>
      </eAnnotations>
