        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A client-defined string that identifies the BlockStatisticsManifest created or modified by this method."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="StatisticsList" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string[]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The metrics that will be included by the filter. The metrics supplied here are the properties of CIM_StatisticalData or one of its subclasses that will remain after the BlockStatisticsManifest filter is applied."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Manifest" eType="#//CIM_BlockStatisticsManifest">
