        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;..&quot;]"/>
        <details key="Values" value="[&quot;CreateSnapshotSupported&quot;,&quot;DestroySnapshotSupported&quot;,&quot;ApplySnapshotSupported&quot;,&quot;DMTF Reserved&quot;]"/>
