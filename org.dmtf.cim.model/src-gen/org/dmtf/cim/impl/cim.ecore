        <details key="cimType" value="string[]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_TelnetProtocolEndpoint.EnabledTerminalModes&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="If the EnabledTerminalModes property is set to 1, &quot;Other&quot; then free form string providing more information about supported terminal mode. If not set to 1, this string has no meaning."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TerminalMode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
