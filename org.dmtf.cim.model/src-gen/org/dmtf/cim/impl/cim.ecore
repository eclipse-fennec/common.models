        <details key="Units" value="Bytes"/>
        <details key="MinValue" value="512"/>
        <details key="MaxValue" value="16777215"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|iSCSI-MIB.iscsiCxnMaxXmitDataSegLength&quot;]"/>
        <details key="PUnit" value="byte"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The maximum data payload size supported for command or data PDUs to be sent on this connection."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="HeaderDigestMethod" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;3&quot;]"/>
        <details key="Values" value="[&quot;Other&quot;,&quot;No Digest&quot;,&quot;CRC32C&quot;]"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|iSCSI-MIB.iscsiCxnHeaderIntegrity&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_iSCSIConnectionSettings.PrimaryHeaderDigestMethod&quot;,&quot;CIM_iSCSIConnectionSettings.SecondaryHeaderDigestMethod&quot;,&quot;CIM_iSCSIConnection.OtherHeaderDigestMethod&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This property identifies the iSCSI header digest scheme in use within this connection."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="OtherHeaderDigestMethod"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
