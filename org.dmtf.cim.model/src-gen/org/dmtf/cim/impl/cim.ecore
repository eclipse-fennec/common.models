      <details key="override.GroupComponent.Aggregate" value="true"/>
      <details key="override.GroupComponent.Max" value="1"/>
      <details key="override.GroupComponent.Description" value="A module that has ports."/>
      <details key="override.PartComponent" value="CIM_NetworkPort REF"/>
      <details key="override.PartComponent.Description" value="A Port that is associated with a module."/>
      <details key="keys" value="GroupComponent,PartComponent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="ModulePort associates ports with their hosting modules."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_MultiStateSensor" eSuperTypes="#//CIM_Sensor">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.6.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Sensors"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,DeviceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Multi-StateSensor is a multi-member set of Sensors."/>
