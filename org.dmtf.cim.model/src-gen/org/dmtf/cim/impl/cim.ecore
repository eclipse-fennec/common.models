  <eClassifiers xsi:type="ecore:EClass" name="CIM_SwitchService" eSuperTypes="#//CIM_ForwardingService">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.7.0"/>
      <details key="UMLPackagePath" value="CIM::Network::SwitchingBridging"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Generic switch (bridging) service class. Additional switching functions are incorporated as subordinate services related to this class via ServiceComponent associations."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="BridgeAddress" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
        <details key="MaxLen" value="32"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|BRIDGE-MIB.dot1dBaseBridgeAddress&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_SwitchService.BridgeAddressType&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Address used by this SwitchService when it must be uniquely identified. For an ethernet bridge, the MAC Address serves as the BridgeAddress. When concatenated with a SpanningTreeService Priority, a unique bridge identifier results. The MAC address is formatted as twelve hexadecimal digits (e.g., &quot;010203040506&quot;), with each pair representing one of the six octets of the MAC address in &quot;canonical&quot; bit order according to RFC 2469. In other scenarios, like Ipv6, the address is formatted as &quot;ffff:ffff:ffff:ffff&quot;."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NumPorts" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|BRIDGE-MIB.dot1dBaseNumPorts&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The number of switch ports controlled by this switching service."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="BridgeType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint8"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Transparent-only&quot;,&quot;SourceRoute-only&quot;,&quot;SRT&quot;]"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|BRIDGE-MIB.dot1dBaseType&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates what type of switching service can be performed."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="BridgeAddressType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;]"/>
        <details key="Values" value="[&quot;Other&quot;,&quot;IPv4&quot;,&quot;IPv6&quot;,&quot;MAC&quot;,&quot;MAC + Spanning Tree Priority&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_SwitchService.BridgeAddress&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="BridgeAddressType defines the type of addressing scheme used for this Bridge and its BridgeAddress property."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
