        <details key="Values" value="[&quot;Success&quot;,&quot;Not Supported&quot;,&quot;Unknown&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;In Use&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method for a given ReplicationType returns the supported Operations on a StorageSynchronized association that can be supplied to the ModifyReplicaSynchronization method."/>
      </eAnnotations>
      <eParameters name="ReplicationType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="uint16"/>
          <details key="ModelCorrespondence" value="[&quot;CIM_ReplicationServiceCapabilities.SupportedReplicationTypes&quot;]"/>
        </eAnnotations>
