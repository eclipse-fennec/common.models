        <details key="cimType" value="string"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Additional information provided by the driver. This property may be null if no information is available, or a general description of the device when available, e.g. &quot;Non-rewind tape streamer&quot;."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DeviceMajor" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
