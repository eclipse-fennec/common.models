        <details key="Max" value="1"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The ManagedElement for which statistical or metric data is defined."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Stats" eType="#//CIM_StatisticalData">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="CIM_StatisticalData REF"/>
        <details key="Key" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The statistic information/object."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
