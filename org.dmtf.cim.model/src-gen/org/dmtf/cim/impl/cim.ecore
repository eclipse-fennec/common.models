        <details key="Units" value="MilliVolts"/>
        <details key="MappingStrings" value="[&quot;MIF.DMTF|Power Supply|004.12&quot;]"/>
        <details key="PUnit" value="volt * 10^-3"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The high voltage of Input Voltage Range 2 for this Power Supply, in millivolts. A value of 0 denotes 'unknown'."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Range2InputFrequencyLow"
