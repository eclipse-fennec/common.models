          <details key="cimType" value="string"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A user relevant name for the relationship between the source and target group. If NULL, the implementation assigns a name. If the target group requires an ElementName, the implementation constructs an appropriate ElementName using the RelationshipName. For example, RelationshipName as a prefix followed by &quot;_n&quot; sequence number, where n is a number beginning with 1."/>
        </eAnnotations>
      </eParameters>
