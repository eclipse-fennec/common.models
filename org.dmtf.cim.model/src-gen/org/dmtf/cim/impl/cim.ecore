  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_NamespaceInManager" eSuperTypes="#//CIM_HostedDependency">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
