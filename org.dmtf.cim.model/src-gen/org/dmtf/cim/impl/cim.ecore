        <details key="Values" value="[&quot;Group is nameable&quot;,&quot;Can add to an associated group&quot;,&quot;Empty group is allowed&quot;,&quot;Group associated with view can be empty&quot;,&quot;Nested groups allowed&quot;,&quot;Only one level of nested groups&quot;,&quot;Group can participate in multiple views&quot;,&quot;Maskview deletion deletes unassociated masking group&quot;,&quot;Associated empty group indicates no access&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Enumeration indicating the capabilities of target port groups.&#xA;Group can participate in multiple views: As long as the associated devices are not shared between these views.&#xA;Maskview deletion deletes unassociated masking group: See the parameter DeleteWhenBecomesUnassociated of the CreateGroup method."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SupportedDeviceGroupFeatures"
