      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="CIM_Configuration REF"/>
        <details key="Deprecated" value="[&quot;CIM_ConcreteComponent.PartComponent&quot;]"/>
        <details key="Key" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this element is deprecated. Deprecated description: A Configuration that is part of a &quot;higher-level&quot; Configuration."/>
      </eAnnotations>
