      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: Timeout value in milliseconds that is used to determine when loss of synchronization has occurred. The typical default is 100 msec."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="BypassedState" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
