        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the created group association between the source and the target elements. If a job is created, this parameter may be NULL until the association is actually formed."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetSettingGoal" eType="#//CIM_SettingData">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
