        <details key="Key" value="true"/>
        <details key="Max" value="1"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The destination directory of the Action."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="FileName" eType="#//CIM_CopyFileAction">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="CIM_CopyFileAction REF"/>
        <details key="Key" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Action against the directory."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
