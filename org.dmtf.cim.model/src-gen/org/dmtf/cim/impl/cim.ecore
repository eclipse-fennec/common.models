        <details key="cimType" value="string[]"/>
        <details key="MaxLen" value="32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The TelephoneNumber property specifies a telephone number of the organization, e.g. + 44 582 10101)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TeletexTerminalIdentifier"
