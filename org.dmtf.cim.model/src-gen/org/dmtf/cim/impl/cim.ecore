        <details key="Values" value="[&quot;Other&quot;,&quot;Unknown&quot;,&quot;Direct Mapped&quot;,&quot;2-way Set-Associative&quot;,&quot;4-way Set-Associative&quot;,&quot;Fully Associative&quot;,&quot;8-way Set-Associative&quot;,&quot;16-way Set-Associative&quot;]"/>
