        <details key="Values" value="[&quot;Group is nameable&quot;,&quot;Can add to an associated group&quot;,&quot;Empty group is allowed&quot;,&quot;Group associated with view can be empty&quot;,&quot;Nested groups allowed&quot;,&quot;Only one level of nested groups&quot;,&quot;Group can participate in multiple views&quot;,&quot;Maskview deletion deletes unassociated masking group&quot;,&quot;Associated empty group indicates no access&quot;,&quot;Unassociated group rejects device numbers&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Enumeration indicating the capabilities of device masking groups."/>
