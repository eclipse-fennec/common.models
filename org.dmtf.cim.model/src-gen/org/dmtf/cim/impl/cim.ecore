      <details key="override.GroupComponent.Max" value="1"/>
      <details key="override.GroupComponent.Description" value="The Chassis that contains other PhysicalPackages."/>
      <details key="override.PartComponent" value="CIM_PhysicalPackage REF"/>
      <details key="override.PartComponent.Description" value="The PhysicalPackage which is contained in the Chassis."/>
      <details key="keys" value="GroupComponent,PartComponent"/>
