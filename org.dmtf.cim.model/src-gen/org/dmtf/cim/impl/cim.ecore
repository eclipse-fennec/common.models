    <eOperations name="GetAvailableTargetRelocationExtents" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6&quot;,&quot;..&quot;,&quot;4098..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Completed with No Error&quot;,&quot;Not Supported&quot;,&quot;Unknown&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;In Use&quot;,&quot;DMTF Reserved&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method can be used to retrieve a list of available target Extents that may be used in the relocation of a StoragePool, StorageVolume, or LogicalDisk. This method MUST return Extents from InPool. The returned Extents are available at the time the method returns. There is no guarantee that the same Extents will be available later. This method MUST return the Extents that are not being used as supporting capacity for any other Pools, Volumes, or LogicalDisks that have been allocated from this Pool."/>
      </eAnnotations>
      <eParameters name="TheElement" eType="#//CIM_LogicalElement">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_LogicalElement REF"/>
          <details key="Required" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="TheElement is a storage element as the source of relocation."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetSettingGoal" eType="#//CIM_StorageSetting">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_StorageSetting REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The TargetSettingGoal for which supported extents should be retrieved as available. If a NULL is passed for the Goal, the method will return all available extents, regardless of the goal. There exists a possibility of error in relocating a Pool, Volume, or LogicalDisk to extents retrieved in this manner."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="InPool" eType="#//CIM_StoragePool">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_StoragePool REF"/>
