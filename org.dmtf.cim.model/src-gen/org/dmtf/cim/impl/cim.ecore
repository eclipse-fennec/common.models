      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The scoping Service's CreationClassName."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ServiceName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
        <details key="Key" value="true"/>
        <details key="MaxLen" value="256"/>
        <details key="Propagated" value="CIM_Service.Name"/>
