    <eStructuralFeatures xsi:type="ecore:EAttribute" name="AddressWidth" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="Units" value="Bits"/>
        <details key="PUnit" value="bit"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Processor address width in bits."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="LoadPercentage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
