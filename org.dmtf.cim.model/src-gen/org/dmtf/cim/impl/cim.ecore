        <details key="Values" value="[&quot;Job Completed with No Error&quot;,&quot;Not Supported&quot;,&quot;Unknown&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;In Use&quot;,&quot;DMTF Reserved&quot;,&quot;Method Parameters Checked - Job Started&quot;,&quot;Vendor Reserved&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method queries the set of pools passed in and returns a set of volumes or logical disks that can be composed together based on the specified goal and element passed in. Since there are usually complicated vendor-specific rules for creating these composite volumes, using the representative element can supply more vendor-specific information than would be in a interoperable setting. The client can then use some or all of this list in a call to CreateOrModifyCompositeElement()."/>
      </eAnnotations>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the job (may be null if job completed)."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="InPools" unique="false" upperBound="-1" eType="#//CIM_StoragePool">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_StoragePool REF[]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A list of pools to draw the candidate elements from."/>
