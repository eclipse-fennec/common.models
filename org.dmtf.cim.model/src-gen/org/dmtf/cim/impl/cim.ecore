      <details key="override.ManagedElement" value="CIM_View REF"/>
      <details key="override.ManagedElement.Key" value="true"/>
      <details key="override.ManagedElement.Description" value="The View Class instance that has the CIM_StatisticalData instance."/>
      <details key="override.Stats" value="CIM_StatisticalData REF"/>
      <details key="override.Stats.Key" value="true"/>
      <details key="override.Stats.Description" value="The CIM_StatisticalData instance for the base instance for a View Class (e.g., CIM_StorageVolume instance)."/>
      <details key="keys" value="ManagedElement,Stats"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
