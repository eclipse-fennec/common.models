      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="DMA channel timing. For example, &quot;Type A&quot; (value =4) or &quot;Type F&quot; (6) could be specified."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TypeCTiming" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
