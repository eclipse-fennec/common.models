        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="SyncType describes the type of copy. &#xA;Mirror: create and maintain a copy of the source. &#xA;Snapshot: create a PIT, virtual copy of the &#xA;source. &#xA;Clone: create an unsynchronized copy of the &#xA;source. "/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Mode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
