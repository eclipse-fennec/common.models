      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Information on the parity setting for transmitted data. No parity (value=1), even (value=2), or odd (value=3) can be specified."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="FlowControlInfo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Not Supported&quot;,&quot;None&quot;,&quot;XonXoff&quot;,&quot;RTS/CTS&quot;,&quot;Both XonXoff and RTS/CTS&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An integer enumeration that indicates the flow control (Xon-Xoff or RTS/CTS) for transmitted data."/>
