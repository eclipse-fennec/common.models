  <eClassifiers xsi:type="ecore:EClass" name="CIM_VLANNetwork" eSuperTypes="#//CIM_Network">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.45.0"/>
      <details key="UMLPackagePath" value="CIM::Network"/>
      <details key="MappingStrings" value="[&quot;Recommendation.ITU|M3100.Network&quot;]"/>
      <details key="override.OtherTypeDescription" value="string"/>
      <details key="override.OtherTypeDescription.Description" value="A string describing the type of media that is supported by this VLAN, when the value of the Type property is set to 1 (i.e., &quot;Other&quot;). This property should be set to NULL when the Type property is any value other than 1."/>
      <details key="override.OtherTypeDescription.ModelCorrespondence" value="[&quot;CIM_VLANNetwork.TypeOfMedia&quot;]"/>
      <details key="keys" value="CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_VLANNetwork represent the management aspects of a Virtual Local Area Network (VLAN) as used within a network switch."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="VLANId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="MinValue" value="1"/>
        <details key="MaxValue" value="4094"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|Q-BRIDGE-MIB.VlanId&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A 12-bit VLAN ID used in the VLAN Tag header."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SAIdentifier" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value of the 802.10 SAID field which would be used for this VLAN."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TransmissionSize" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value of this property is set to a positive integer when the value of the MTU for all embers (switch endpoints/endstationendpoints of the VLAN is the same, otherwise is set to -1 and the Transmission size is set on each of the individual endpoints."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TypeOfMedia" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5..16000&quot;,&quot;..&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;Not Applicable&quot;,&quot;Ethernet&quot;,&quot;FDDI&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_VLANNetwork.OtherTypeDescription&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Defines/restricts the media type of the VLAN. This &#xA;information is also needed when a VLAN is not yet associated to any end point."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PrivateVLANType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;]"/>
        <details key="Values" value="[&quot;Not Private&quot;,&quot;Primary&quot;,&quot;Community&quot;,&quot;Isolated&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A private VLAN allows the sub divsion of a VLAN, the Primary VLAN in a single IP subnet. The secondary VLANs can be in a community, they can communicate with each other but not other secondary VLAN in the same primary VLAN, or Isolated - only able to communicate to ports on the Primary VLAN. 2 - Not private 3 - Primary 4 - Community 5- Isolated ),"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PrimaryVLANId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="If PrivateVLANType matches 4(Community) or 5(Isolated) then PrimaryVLANId is the VLANId of primary VLAN to which the VLAN is bound"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="AssociatedVLANIds" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="If PrivateVLANType matches 3(Primary) then associatedVLANId is an array of VLANIds of the secondary VLANs associated with the Primary VLAN"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_VRFConfigurationService" eSuperTypes="#//CIM_Service">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.52.0"/>
      <details key="UMLPackagePath" value="CIM::Network"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_VRFConfigurationService description contains a set of extrinsic methods to manage Virtual Routing and Forwarding tables. The methods include the creation and removal of the VRFs and the managements of the services, port, interfaces and routers, routes that are associated in VRF context."/>
    </eAnnotations>
    <eOperations name="CreateVRF" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
