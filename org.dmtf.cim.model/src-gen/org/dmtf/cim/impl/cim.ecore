        <details key="Propagated" value="CIM_Process.CSCreationClassName"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The scoping Process's ComputerSystem CreationClassName."/>
      </eAnnotations>
    </eStructuralFeatures>
