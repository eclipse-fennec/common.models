      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The PreferredDeliveryMethod property specifies the preferred method to be used for contacting the person."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PreferredLanguage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
