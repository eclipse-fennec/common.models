          <details key="cimType" value="uint16[]"/>
          <details key="Out" value="true"/>
          <details key="ValueMap" value="[&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;..&quot;,&quot;0x8000..&quot;]"/>
          <details key="Values" value="[&quot;Synchronous&quot;,&quot;Asynchronous&quot;,&quot;Adaptive&quot;,&quot;Active&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Specific&quot;]"/>
