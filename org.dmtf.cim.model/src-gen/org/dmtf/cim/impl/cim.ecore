    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="EIGRPInternal" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="90">
