  <eClassifiers xsi:type="ecore:EClass" name="CIM_J2eeDomain" eSuperTypes="#//CIM_AdminDomain">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.8.0"/>
      <details key="UMLPackagePath" value="CIM::Application::J2eeAppServer"/>
      <details key="override.Name" value="string"/>
      <details key="override.Name.Description" value="The name of the J2EE server domain. The name MUST be constructed using the form specified in JSR77.3.1.1.1 in order to avoid the need for manual key propagation."/>
      <details key="override.Name.MaxLen" value="256"/>
      <details key="override.Name.MappingStrings" value="[&quot;JSR77.JCP|JSR77.3.1.1.1.1 Domain Name|V1.0&quot;]"/>
      <details key="keys" value="CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_J2eeDomain identifies the J2EE Domains that are part of the J2EE management environment. Domains provide a structure for grouping J2EE Server objects."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_J2eeEJBInModule" eSuperTypes="#//CIM_ServiceComponent">
