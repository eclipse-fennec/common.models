        <details key="cimType" value="uint32"/>
        <details key="Units" value="Bits per Second"/>
        <details key="PUnit" value="bit / second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Defines the maximum communication speed to the COM Port for an external modem that can be set. Enter 0 if not applicable."/>
