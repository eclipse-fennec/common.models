        <details key="Values" value="[&quot;Success&quot;,&quot;Not Supported&quot;,&quot;Unspecified Error&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;DMTF Reserved&quot;,&quot;Node Creation Not Supported&quot;,&quot;Alias In Use By Other Node&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method creates an iSCSI Node in the form of an instance of SCSIProtocolController. As part of the creation process a SystemDevice association is created between the new SCSIProtocolController and the scoping Network Entity (CIM_ComputerSystem) hosting this service."/>
      </eAnnotations>
      <eParameters name="Alias" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
