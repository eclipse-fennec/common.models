      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mask for the starting IPv4 address of the IPSubnet, if needed (i.e., if the AddressType property is 1, &quot;IPv4&quot;)."/>
      </eAnnotations>
