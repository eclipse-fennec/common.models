        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="List of elements to consider. For example, a list of storage pools."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TierSettingData" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="string"/>
          <details key="EmbeddedInstance" value="CIM_TierSettingData"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="If provided, it overrides the default tier setting data that is used. For example, a storage tier based on performance of underlying technology of components considered."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Goal" eType="#//CIM_ManagedElement">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ManagedElement REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The Quality of Service per the properties of supplied StorageSetting."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Job" eType="#//CIM_ConcreteJob">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ConcreteJob REF"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the job (may be NULL if job is completed)."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Candidates" unique="false" upperBound="-1" eType="#//CIM_LogicalElement">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
