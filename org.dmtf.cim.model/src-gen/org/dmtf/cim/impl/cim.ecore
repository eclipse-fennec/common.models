    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ServiceTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="datetime"/>
        <details key="MappingStrings" value="[&quot;JSR77.JCP|JSR77.6.32.1.1 getServiceTime|V1.0&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The execution time of the servlet's service method. The time is represented as a datetime interval."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ServletTimeMaxTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="datetime"/>
        <details key="MappingStrings" value="[&quot;JSR77.JCP|JSR77.6.6.1.2 getMaxTime|V1.0&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The maximum execution time of the servlet's service method since the beginning of this measurement. The time is represented as a datetime interval."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ServiceTimeMinTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="datetime"/>
        <details key="MappingStrings" value="[&quot;JSR77.JCP|JSR77.6.6.1.3 getMinTime|V1.0&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The minimum execution time of the servlet's service method since the beginning of this measurement. The time is represented as a datetime interval."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ServletTimeTotalTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="datetime"/>
        <details key="MappingStrings" value="[&quot;JSR77.JCP|JSR77.6.6.1.4 getTotalTime|V1.0&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The total execution time of the servlet's service method since the beginning of this measurement. Dividing ServletTimeTotalTime by ServletTime will provide the average time spent executing the servlet's service method. The time is represented as a datetime interval."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
