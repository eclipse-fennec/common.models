      <details key="Version" value="2.7.0"/>
      <details key="UMLPackagePath" value="CIM::Policy"/>
      <details key="override.GroupComponent" value="CIM_PolicyRepository REF"/>
      <details key="override.GroupComponent.Deprecated" value="[&quot;CIM_PolicyContainerInPolicyContainer.GroupComponent&quot;]"/>
      <details key="override.GroupComponent.Aggregate" value="true"/>
