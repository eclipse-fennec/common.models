    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="EnabledLogicalElementCapabilities describes the capabilities supported for changing the state of the assciated EnabledLogicalElement."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ElementNameEditSupported"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
