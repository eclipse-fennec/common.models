      <details key="override.PartComponent" value="CIM_ResourceAllocationSettingData REF"/>
      <details key="override.PartComponent.Description" value="Reference to an instance of the CIM_ResourceAllocationSettingData class representing a part of a virtual system configuration applicable to one particular virtual resource."/>
