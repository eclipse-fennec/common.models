  <eClassifiers xsi:type="ecore:EClass" name="CIM_SAPAvailableForFileShare" eSuperTypes="#//CIM_SAPAvailableForElement">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.45.0"/>
      <details key="UMLPackagePath" value="CIM::System::FileServices"/>
      <details key="override.ManagedElement" value="CIM_FileShare REF"/>
      <details key="override.ManagedElement.Key" value="true"/>
      <details key="override.ManagedElement.Description" value="The FileShare for which the SAP is available."/>
      <details key="keys" value="AvailableSAP,ManagedElement"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_SAPAvailableForFileShare conveys the semantics of a Service Access Point that is available for a ManagedElement. When CIM_SAPAvailableForElement is not instantiated, then the SAP is assumed to be generally available. If instantiated, the SAP is available only for the associated ManagedElements. For example, a device might provide management access through a URL. This association allows the URL to be advertised for the device."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_SnapshotOfVirtualSystem" eSuperTypes="#//CIM_Dependency">
