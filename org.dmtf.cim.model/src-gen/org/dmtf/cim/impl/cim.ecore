      <details key="Deprecated" value="[&quot;CIM_AssociatedSensor&quot;]"/>
      <details key="Version" value="2.8.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Sensors"/>
      <details key="override.Antecedent" value="CIM_VoltageSensor REF"/>
      <details key="override.Antecedent.Deprecated" value="[&quot;CIM_AssociatedSensor.Antecedent&quot;]"/>
      <details key="override.Antecedent.Description" value="The VoltageSensor."/>
      <details key="override.Dependent" value="CIM_PowerSupply REF"/>
      <details key="override.Dependent.Deprecated" value="[&quot;CIM_AssociatedSensor.Dependent&quot;]"/>
