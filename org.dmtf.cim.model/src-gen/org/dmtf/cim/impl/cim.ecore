        <details key="cimType" value="boolean"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_IndicationService.SubscriptionRemovalAction&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Boolean indicating whether the SubscriptionRemovalAction property can be set by a client application."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SubscriptionRemovalTimeIntervalIsSettable"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject">
