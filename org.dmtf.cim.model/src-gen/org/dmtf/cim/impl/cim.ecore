          <details key="cimType" value="CIM_LogicalElement REF[]"/>
          <details key="ArrayType" value="Indexed"/>
          <details key="ModelCorrespondence" value="[&quot;CIM_ReplicationService.AddElementsToGroupSynchronized(SourceElements)&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Reference to the elements to add to the target group. &#xA;Pairing of source and target elements is controlled by the Pairing property of ReplicationSettingData if supplied, otherwise, based on default ReplicationSettingData."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="SourceAccessPoint" eType="#//CIM_ServiceAccessPoint">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
