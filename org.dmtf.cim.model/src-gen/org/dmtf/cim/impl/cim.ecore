  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_ManagesAccount" eSuperTypes="#//CIM_Dependency">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.6.0"/>
      <details key="UMLPackagePath" value="CIM::User::Account"/>
      <details key="override.Antecedent" value="CIM_AccountManagementService REF"/>
      <details key="override.Antecedent.Description" value="The account management service."/>
      <details key="override.Dependent" value="CIM_Account REF"/>
      <details key="override.Dependent.Description" value="An account managed by the service."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This relationship associates the AccountManagement security service to the Accounts for which it is responsible."/>
