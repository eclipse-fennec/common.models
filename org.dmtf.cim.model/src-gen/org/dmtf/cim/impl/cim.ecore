      <details key="override.Dependent" value="CIM_ObjectManagerCommunicationMechanism REF"/>
      <details key="override.Dependent.Min" value="1"/>
      <details key="override.Dependent.Description" value="The encoding/protocol/set of operations that may be used to communicate with the referenced ObjectManager."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CommMechanismForManager is deprecated. See CIM_WBEMServer, CIM_ProtocolService and CIM_WBEMProtocolServiceCapabilties for describing WBEM Protocols.&#xA;CommMechanismForManager is an association between an ObjectManager and an ObjectManagerCommunicationMechanism class. The latter describes a possible encoding/protocol/ set of operations for accessing the referenced ObjectManager."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_CommMechanismForObjectManagerAdapter"
