        <details key="Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;Short DNS Name&quot;,&quot;Fully qualified DNS Name&quot;,&quot;Windows Domain Name&quot;,&quot;NetWare Server Name&quot;,&quot;Unix Hostname&quot;,&quot;Globally Unique System Identifier&quot;,&quot;IP Address&quot;,&quot;Modem Dialup String&quot;,&quot;MAC Address&quot;,&quot;IPMI Address&quot;]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_SystemIdentification.IdentificationData&quot;,&quot;CIM_SystemIdentification.FormatDescriptions&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Enumeration indicating the format of the system identification and/or addressing information."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="FormatDescriptions" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string[]"/>
        <details key="Write" value="true"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_SystemIdentification.IdentificationFormats&quot;,&quot;CIM_SystemIdentification.IdentificationData&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Strings further describing the format of the system identification information."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="IdentificationData" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
