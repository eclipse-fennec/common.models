        <details key="Deprecated" value="[&quot;CIM_IPConnectivitySubnet.PrefixLength&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The prefix length for IPv6 addresses in the IPSubnet, if needed (i.e., if the AddressType property is 2, &quot;IPv6&quot;)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="AddressType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
