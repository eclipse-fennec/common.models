    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_J2eeResourceAdapterModule identifies a deployed Resource Adapter Module and is a container for resource adapters."/>
    </eAnnotations>
  </eClassifiers>
