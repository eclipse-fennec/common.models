  <eClassifiers xsi:type="ecore:EClass" name="CIM_OtherGroupInformation" eSuperTypes="#//CIM_ManagedElement">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.6.0"/>
      <details key="UMLPackagePath" value="CIM::User::Group"/>
      <details key="keys" value="CreationClassName,Name"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The OtherGroupInformation class provides additional information about an associated Group instance. This class is defined so as to incorporate commonly-used LDAP attributes to permit implementations to easily derive this information from LDAP-accessible directories."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="CreationClassName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
