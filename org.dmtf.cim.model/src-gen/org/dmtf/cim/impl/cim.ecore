  <eClassifiers xsi:type="ecore:EClass" name="CIM_ToDirectoryAction">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.6.0"/>
      <details key="UMLPackagePath" value="CIM::Application::CheckAction"/>
      <details key="keys" value="DestinationDirectory,FileName"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The ToDirectoryAction association identifies the target directory for a FileAction. When this association is used, the assumption is that the target directory was created by a previous Action. This association cannot co-exist with a ToDirectorySpecification association, since a FileAction can only involve a single target directory."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="DestinationDirectory" eType="#//CIM_DirectoryAction">
