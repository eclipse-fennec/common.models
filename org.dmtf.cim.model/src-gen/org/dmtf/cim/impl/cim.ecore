      <details key="override.Element.Description" value="The PhysicalElement whose location is specified."/>
      <details key="override.PhysicalLocation" value="CIM_Location REF"/>
      <details key="override.PhysicalLocation.Max" value="1"/>
      <details key="override.PhysicalLocation.Description" value="The location of the PhysicalElement."/>
      <details key="keys" value="Element,PhysicalLocation"/>
