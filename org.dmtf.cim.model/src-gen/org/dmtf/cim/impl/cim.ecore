    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Static" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        defaultValueLiteral="1">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
