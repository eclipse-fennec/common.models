  <eClassifiers xsi:type="ecore:EClass" name="CIM_PoweredStatisticalData" eSuperTypes="#//CIM_StatisticalData">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.45.0"/>
      <details key="UMLPackagePath" value="CIM::Device::PowerMgmt"/>
      <details key="keys" value="InstanceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Statistical information related to the powered-on time of a Managed Element."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PowerOnHours" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="datetime"/>
