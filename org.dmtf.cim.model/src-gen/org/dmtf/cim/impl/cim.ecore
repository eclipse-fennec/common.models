      <details key="UMLPackagePath" value="CIM::Network::Filtering"/>
      <details key="override.GroupComponent" value="CIM_ComputerSystem REF"/>
      <details key="override.GroupComponent.Deprecated" value="[&quot;CIM_HostedFilterList.Antecedent&quot;]"/>
      <details key="override.GroupComponent.Aggregate" value="true"/>
      <details key="override.GroupComponent.Max" value="1"/>
      <details key="override.GroupComponent.Description" value="The ComputerSystem/network device that scopes the FilterList and administers it."/>
      <details key="override.PartComponent" value="CIM_FilterList REF"/>
      <details key="override.PartComponent.Deprecated" value="[&quot;CIM_HostedFilterList.Dependent&quot;]"/>
      <details key="override.PartComponent.Description" value="The FilterList on the System."/>
      <details key="keys" value="GroupComponent,PartComponent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="FilterLists are defined in the context of a ComputerSystem (e.g., a router, firewall or host). Note that this class is deprecated since its subclassing is not correct. It subclasses from SystemComponent, but a FilterList is NOT a Component of a System. Instead, it is hosted/scoped by the System. In versions up to CIM 2.6, FilterListInSystem was a mandatory, Weak relationship. This is no longer true, beginning with CIM V2.7."/>
    </eAnnotations>
  </eClassifiers>
