    <eOperations name="RemoveManifests" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;..&quot;,&quot;4096&quot;,&quot;4097..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Success&quot;,&quot;Not Supported&quot;,&quot;Unknown&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;Method Reserved&quot;,&quot;Manifest not found&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Extrinsic method that removes manifests from a BlockStatisticsManifestCollection."/>
      </eAnnotations>
      <eParameters name="ManifestCollection" eType="#//CIM_BlockStatisticsManifestCollection">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_BlockStatisticsManifestCollection REF"/>
        </eAnnotations>
