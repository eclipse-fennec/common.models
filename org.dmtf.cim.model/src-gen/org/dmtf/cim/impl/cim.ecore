      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A string describing the Header Digest scheme in use when HeaderDigestMethod is equal to the value 1, &quot;Other&quot;."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="DataDigestMethod" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;3&quot;]"/>
        <details key="Values" value="[&quot;Other&quot;,&quot;No Digest&quot;,&quot;CRC32C&quot;]"/>
        <details key="MappingStrings" value="[&quot;MIB.IETF|iSCSI-MIB.iscsiCxnDataIntegrity&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_iSCSIConnectionSettings.PrimaryHeaderDigestMethod&quot;,&quot;CIM_iSCSIConnectionSettings.SecondaryHeaderDigestMethod&quot;,&quot;CIM_iSCSIConnection.OtherDataDigestMethod&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
