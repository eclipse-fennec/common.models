        <details key="MaxLen" value="256"/>
        <details key="Propagated" value="CIM_SharedSecretService.SystemCreationClassName"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The scoping System's CCN."/>
