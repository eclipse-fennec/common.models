        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;..&quot;,&quot;4096&quot;,&quot;4097&quot;,&quot;4098&quot;,&quot;4099..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Success&quot;,&quot;Not Supported&quot;,&quot;Unknown&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;Method Reserved&quot;,&quot;Element Not Supported&quot;,&quot;Metric not supported&quot;,&quot;ElementType Parameter Missing&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Method that creates or modifies a BlockStatisticsManifest for this statistics service. A client supplies a BlockStatisticsManifestCollection in which the new BlockStatisticsManifest will be placed or an existing BlockStatisticsManifest will be modified, the element type of the statistics that the BlockStatisticsManifest will filter, and a list of metrics, which serves as a filter for statistical data of that element type."/>
      </eAnnotations>
      <eParameters name="ManifestCollection" eType="#//CIM_BlockStatisticsManifestCollection">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_BlockStatisticsManifestCollection REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="BlockStatisticsManifestCollection that the BlockStatisticsManifest is or should be a member of."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="ElementType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
