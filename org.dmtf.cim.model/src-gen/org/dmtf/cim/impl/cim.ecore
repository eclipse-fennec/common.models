  <eClassifiers xsi:type="ecore:EClass" name="CIM_SAPAvailableForElement">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Version" value="2.10.0"/>
      <details key="UMLPackagePath" value="CIM::Core::Service"/>
      <details key="keys" value="AvailableSAP,ManagedElement"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_SAPAvailableForElement conveys the semantics of a Service Access Point that is available for a ManagedElement. When CIM_SAPAvailableForElement is not instantiated, then the SAP is assumed to be generally available. If instantiated, the SAP is available only for the associated ManagedElements. For example, a device might provide management access through a URL. This association allows the URL to be advertised for the device."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="AvailableSAP" eType="#//CIM_ServiceAccessPoint">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="CIM_ServiceAccessPoint REF"/>
        <details key="Key" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Service Access Point that is available."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ManagedElement" eType="#//CIM_ManagedElement">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="CIM_ManagedElement REF"/>
        <details key="Key" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The ManagedElement for which the SAP is available."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_SAPSAPDependency" eSuperTypes="#//CIM_Dependency">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
