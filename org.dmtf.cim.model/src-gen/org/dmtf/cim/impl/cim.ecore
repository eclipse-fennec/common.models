          <details key="In" value="false"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="An array of storage objects that can form a storage tier."/>
        </eAnnotations>
      </eParameters>
