      <details key="override.GroupComponent.Deprecated" value="[&quot;No value&quot;]"/>
      <details key="override.GroupComponent.Aggregate" value="true"/>
      <details key="override.GroupComponent.Max" value="1"/>
      <details key="override.GroupComponent.Description" value="The BGPService that aggregates BGPPathAttributes as part of its routing information."/>
      <details key="override.PartComponent" value="CIM_BGPPathAttributes REF"/>
      <details key="override.PartComponent.Deprecated" value="[&quot;No value&quot;]"/>
      <details key="override.PartComponent.Max" value="1"/>
      <details key="override.PartComponent.Description" value="The BGP attribute, which are part-of the BGP UPDATE message."/>
      <details key="keys" value="GroupComponent,PartComponent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This is a specialization of the Component aggregation. This aggregation defines the set of BGPPathAttributes that are transmitted in per-path UPDATE messages. The association is deprecated since it is incorrectly defined as a Component relationship, and since the properties of BGPPathAttribute are path/endpoint-specific (not defined at the level of the Service)."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_BGPServiceStatistics" eSuperTypes="#//CIM_ServiceStatistics">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
