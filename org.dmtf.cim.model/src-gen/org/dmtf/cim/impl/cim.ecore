        <details key="cimType" value="CIM_StatisticsCollection REF"/>
        <details key="Key" value="true"/>
        <details key="Min" value="1"/>
        <details key="Max" value="1"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The collection of statistics filtered by the BlockStatisticsManifestCollection."/>
