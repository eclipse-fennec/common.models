  <eClassifiers xsi:type="ecore:EClass" name="CIM_AuthenticationService" eSuperTypes="#//CIM_SecurityService">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.8.0"/>
