      <details key="override.Antecedent" value="CIM_System REF"/>
      <details key="override.Antecedent.Key" value="true"/>
      <details key="override.Antecedent.Description" value="Antecedent shall be a reference to a CIM_System that has a relationship with the managed resource."/>
      <details key="override.Dependent" value="CIM_View REF"/>
      <details key="override.Dependent.Key" value="true"/>
      <details key="override.Dependent.Description" value="Dependent shall be a reference to an instance of CIM_View that represents a de-normalized or aggregate view of a managed resource that is related to the CIM_System referenced by the Antecedent property."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_ScopedView is used to associate an instance of CIM_System with a View instance representing the denormalized view of a managed resource related to the system. The type of relationship is not constrained. Examples include hosting, aggregation, composition, dependencies, etc."/>
    </eAnnotations>
  </eClassifiers>
