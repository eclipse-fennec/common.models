      <details key="UMLPackagePath" value="CIM::Core::Statistics"/>
      <details key="keys" value="ManagedElement,Stats"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_ElementStatisticalData is an association that relates a ManagedElement to its StatisticalData. Note that the cardinality of the ManagedElement reference is Min(1), Max(1). This cardinality mandates the instantiation of the ElementStatisticalData association for the referenced instance of CIM_StatisticalData. ElementStatisticalData describes the existence requirements and context for the CIM_StatisticalData, relative to a specific ManagedElement."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ManagedElement" eType="#//CIM_ManagedElement">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="CIM_ManagedElement REF"/>
