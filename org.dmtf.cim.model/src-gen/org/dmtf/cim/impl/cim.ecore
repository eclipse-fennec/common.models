        <details key="cimType" value="string"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Based on inetOrgPerson, the person's preferred written or spoken language."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="RegisteredAddress" unique="false"
