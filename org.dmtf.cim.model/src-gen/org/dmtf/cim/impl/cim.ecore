      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method, for a given ReplicationType and a supplied property, returns an array of supported settings that can be utilized in an instance of the ReplicationSettingData class. &#xA;Property Is Not Supported: Implementation does not support the property. &#xA;Use the method GetSupportedReplicationSettingDataDateTime for properties that have datatime data type. Their use in this method is deprecated."/>
