          <details key="MaxLen" value="128"/>
          <details key="ModelCorrespondence" value="[&quot;CIM_SCSIProtocolController.ElementName&quot;]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The iSCSI Alias for the new Node."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="iSCSINode" eType="#//CIM_SCSIProtocolController">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_SCSIProtocolController REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The SCSIProtocolController instance representing the created iSCSI Node."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eOperations name="DeleteiSCSINode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6..4095&quot;,&quot;4096&quot;,&quot;4097&quot;,&quot;4098..32767&quot;,&quot;32768..65535&quot;]"/>
        <details key="Values" value="[&quot;Success&quot;,&quot;Not Supported&quot;,&quot;Unspecified Error&quot;,&quot;Timeout&quot;,&quot;Failed&quot;,&quot;Invalid Parameter&quot;,&quot;DMTF Reserved&quot;,&quot;SCSIProtocolController Non-Existent&quot;,&quot;Sessions Active on Node Ports&quot;,&quot;Method Reserved&quot;,&quot;Vendor Specific&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This method deletes an instance of SCSIProtocolController respresenting an iSCSI Node. If Sessions are active on iSCSIProtocolEndpoints belonging to this node an error will be returned. If no Sessions are active the scoped iSCSIProtocolEndpoints will be deleted."/>
      </eAnnotations>
      <eParameters name="iSCSINode" eType="#//CIM_SCSIProtocolController">
