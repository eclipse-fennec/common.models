  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_HostedStoragePoolView" eSuperTypes="#//CIM_AbstractComponent">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Association" value="true"/>
      <details key="Aggregation" value="true"/>
      <details key="Version" value="2.45.0"/>
      <details key="UMLPackagePath" value="CIM::Device::ComponentElement"/>
      <details key="override.GroupComponent" value="CIM_System REF"/>
      <details key="override.GroupComponent.Key" value="true"/>
      <details key="override.GroupComponent.Aggregate" value="true"/>
      <details key="override.GroupComponent.Description" value="The CIM_System instance that scopes the underlying Pool instance of the view class."/>
      <details key="override.PartComponent" value="CIM_StoragePoolView REF"/>
      <details key="override.PartComponent.Key" value="true"/>
      <details key="override.PartComponent.Description" value="The view class instance that is a Pool on the CIM_System instance."/>
      <details key="keys" value="GroupComponent,PartComponent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This aggregates Pool view class instances to the CIM_System that scopes the underlying Pools of the View Classes."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_IDEController" eSuperTypes="#//CIM_Controller">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.6.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Controller"/>
      <details key="keys" value="SystemCreationClassName,SystemName,CreationClassName,DeviceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
