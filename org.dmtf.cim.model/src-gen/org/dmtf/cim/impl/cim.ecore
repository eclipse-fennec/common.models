        <details key="Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;Console&quot;,&quot;Stream&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ArrayType" value="Indexed"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_TelnetProtocolEndpoint.OtherEnabledCharacterDisplayMode&quot;]"/>
