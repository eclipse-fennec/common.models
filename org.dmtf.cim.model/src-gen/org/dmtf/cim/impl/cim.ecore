        <details key="cimType" value="uint16"/>
        <details key="Required" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The maximum number of partitions that can be BasedOn the Underlying extent."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MaxCapacity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64"/>
        <details key="Required" value="true"/>
        <details key="Units" value="Blocks"/>
        <details key="PUnit" value="count"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The largest partition size (in blocks) of this style supported on this platform."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="OverlapAllowed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"
        defaultValueLiteral="false">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="boolean"/>
        <details key="Required" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The platform supports partitions with overlapping address ranges."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PartitionTableSize" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint32"/>
        <details key="Required" value="true"/>
        <details key="Units" value="Blocks"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_StorageExtent.ConsumableBlocks&quot;]"/>
        <details key="PUnit" value="count"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The number of block occupied by the partition table and other metadata. The effective block size for partitions is the StorageExtent's ConsumableBlocks minus this size."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SupportedSynchronousActions"
        unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;2&quot;,&quot;3&quot;,&quot;..&quot;,&quot;0x8000..&quot;]"/>
        <details key="Values" value="[&quot;SetPartitionStyle&quot;,&quot;CreateOrModifyPartition&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Enumeration indicating what operations will be executed synchronously. If an operation is included in this property then the underlying implementation is indicating that it supports the operation without the creation of a job."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
