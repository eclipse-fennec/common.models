    <eStructuralFeatures xsi:type="ecore:EReference" name="NetworkService" eType="#//CIM_NetworkService">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="CIM_NetworkService REF"/>
        <details key="Deprecated" value="[&quot;No value&quot;]"/>
