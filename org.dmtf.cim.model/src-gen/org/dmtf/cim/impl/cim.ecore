        <details key="cimType" value="uint64"/>
        <details key="MappingStrings" value="[&quot;FC-SWAPI.T11|PerformanceRates|1.SWAPI_STATS_LBL_RBYR&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_StatisticalData.SampleInterval&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="RxRate is the instantaneous receive byte rate."/>
