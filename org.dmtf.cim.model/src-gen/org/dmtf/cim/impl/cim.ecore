    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_InstCreation notifies when a new instance is created."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_InstDeletion" eSuperTypes="#//CIM_InstIndication">
