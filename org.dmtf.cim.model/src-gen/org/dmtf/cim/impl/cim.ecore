  <eClassifiers xsi:type="ecore:EClass" name="CIM_WiFiPortCapabilities" eSuperTypes="#//CIM_NetworkPortCapabilities">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.55.0"/>
      <details key="UMLPackagePath" value="CIM::Device::Ports"/>
      <details key="keys" value="InstanceID"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="CIM_WiFiPortCapabilities is a specialization of CIM_NetworkPortCapabilities that describes the capabilities of a WiFiPort."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SupportedPortTypes" unique="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;70&quot;,&quot;71&quot;,&quot;72&quot;,&quot;73&quot;,&quot;74&quot;,&quot;75&quot;,&quot;76&quot;,&quot;77&quot;,&quot;..&quot;,&quot;16000..65535&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;Other&quot;,&quot;802.11a&quot;,&quot;802.11b&quot;,&quot;802.11g&quot;,&quot;802.11n (Wi-Fi 4)&quot;,&quot;802.11ac (Wi-Fi 5)&quot;,&quot;802.11ax (Wi-Fi 6)&quot;,&quot;802.11ax (Wi-Fi 6E)&quot;,&quot;802.11be (Wi-Fi 7)&quot;,&quot;DMTF Reserved&quot;,&quot;Vendor Reserved&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_WiFiPort.PortType&quot;,&quot;CIM_WiFiPortCapabilities.OtherSupportedPortTypes&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The 802.11 modes that the Port supports. See description of PortType property in CIM_WiFiPort for more information."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="OtherSupportedPortTypes"
        unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string[]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_WiFiPort.OtherPortType&quot;,&quot;CIM_WiFiPortCapabilities.SupportedPortTypes&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Additional 802.11 modes supported by the associated WiFiPort, but not listed in the valuemap for SupportedPortTypes."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CIM_ZoneCapabilities" eSuperTypes="#//CIM_Capabilities">
