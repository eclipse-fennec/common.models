      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This property represents the type of managment address identifiers encoding used to represent management addresses. &quot;3 (MAC address)&quot; value indicates that this string identifies a particular unicast MAC address (encoded in network byte order and IEEE 802.3 canonical bit order). &quot;4 (Network address)&quot; value identifies a network address. The first octet contains the IANA AddressFamilyNumbers enumeration value for the specific address type, and octets 2 through N contain the networkAddress address value in network byte order."/>
      </eAnnotations>
    </eStructuralFeatures>
