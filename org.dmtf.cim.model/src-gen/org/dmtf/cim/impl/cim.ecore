        <details key="MappingStrings" value="[&quot;MIB.IETF|MIB-II.ifInOctets&quot;,&quot;MIF.DMTF|Network Adapter 802 Port|001.9&quot;]"/>
        <details key="PUnit" value="byte"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
