        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;CIM_FCPort.Speed&quot;]"/>
        <details key="Units" value="Bits per Second"/>
        <details key="PUnit" value="bit / second"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The speed for communications that is currently negotiated between the two Ports. Speed is specified in Bits per Second. If this information is not available, the property should be set to 0."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ACKModel" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
