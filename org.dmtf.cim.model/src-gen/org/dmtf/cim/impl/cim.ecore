        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The definition for the SettingData to be maintained by the target storage objects (the replicas). If target elements are supplied, this parameter shall be NULL."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetPool" eType="#//CIM_ResourcePool">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ResourcePool REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The underlying storage for the target elements (the replicas) will be drawn from TargetPool if specified, otherwise the allocation is implementation specific. If target elements are supplied, this parameter shall be NULL. &#xA;If TargetPool supplied, TargetPools shall be NULL."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="TargetPools" unique="false" upperBound="-1" eType="#//CIM_ResourcePool">
