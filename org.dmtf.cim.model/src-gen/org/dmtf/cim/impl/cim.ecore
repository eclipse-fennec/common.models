          <details key="cimType" value="CIM_BlockStatisticsManifest REF"/>
          <details key="Out" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The BlockStatisticsManifest that is created or modified on successful execution of the method."/>
