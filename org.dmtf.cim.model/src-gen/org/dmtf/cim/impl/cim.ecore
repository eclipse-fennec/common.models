      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An enumeration that describes the format of the address properties in IPSubnet."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
