        <details key="cimType" value="boolean"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A true value indicates that physical capacity alerts governed by PhysicalCapacityWarningAlertThreshold and PhysicalCapacityCriticalAlertThreshold will be issued."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PhysicalCapacityWarningAlertThreshold"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
