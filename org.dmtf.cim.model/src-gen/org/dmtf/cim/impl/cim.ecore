        <details key="cimType" value="uint16"/>
        <details key="ValueMap" value="[&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;]"/>
        <details key="Values" value="[&quot;Other&quot;,&quot;Unknown&quot;,&quot;ISA Compatible&quot;,&quot;Not Supported&quot;,&quot;Supported&quot;]"/>
        <details key="MappingStrings" value="[&quot;MIF.DMTF|System Resource DMA Info|001.10&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates whether C type (burst) timing is supported (value=5) or not (value=4). Also, &quot;Other&quot; (1), &quot;Unknown&quot; (2) and &quot;ISA Compatible&quot; (3) are defined."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
