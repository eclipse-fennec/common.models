      <details key="override.GroupComponent.Deprecated" value="[&quot;CIM_ExtentRedundancyComponent.GroupComponent&quot;]"/>
      <details key="override.GroupComponent.Aggregate" value="true"/>
      <details key="override.GroupComponent.Description" value="The StorageRedundancyGroup."/>
      <details key="override.PartComponent" value="CIM_AggregatePExtent REF"/>
      <details key="override.PartComponent.Deprecated" value="[&quot;CIM_ExtentRedundancyComponent.PartComponent&quot;]"/>
      <details key="override.PartComponent.Description" value="The AggregatePExtent participating in the RedundancyGroup."/>
      <details key="keys" value="GroupComponent,PartComponent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Describes the AggregatePExtent in a StorageRedundancyGroup. However, there is no need for the specificity of this association. It is deprecated in lieu of the generic ExtentRedundancyComponent relationship, its superclass."/>
