        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="An array of references to local ServiceAccessPoints (for example, ProtocolEndpoints) that allow communication to the remote system."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="RemoteAccessPoints" unique="false" upperBound="-1" eType="#//CIM_ServiceAccessPoint">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_ServiceAccessPoint REF[]"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="An array of references to remote ServiceAccessPoints (for example, ProtocolEndpoints) that allow communication to the remote system."/>
        </eAnnotations>
      </eParameters>
