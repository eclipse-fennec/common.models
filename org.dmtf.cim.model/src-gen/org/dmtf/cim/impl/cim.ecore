      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The responder to the login."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NegotiatedCOS" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16"/>
        <details key="Deprecated" value="[&quot;CIM_FCPort.ActiveCOS&quot;]"/>
        <details key="Key" value="true"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6&quot;]"/>
        <details key="Values" value="[&quot;Unknown&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;6&quot;,&quot;F&quot;]"/>
        <details key="MappingStrings" value="[&quot;MIF.DMTF|Fibre Channel Bus PortExtensions|001.5&quot;]"/>
        <details key="ModelCorrespondence" value="[&quot;CIM_FibreChannelAdapter.SupportedCOS&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The Fibre Channel Class of Service that is currently running between the Ports. Because two Ports can be simultaneously connected at different Classes of Service, this property had to be part of the key of the object and therefore, the identity of the instance."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NegotiatedFrameSize" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint64"/>
        <details key="Deprecated" value="[&quot;CIM_FCPort.ActiveMaximumTransmissionUnit&quot;]"/>
        <details key="Units" value="Bytes"/>
        <details key="PUnit" value="byte"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this method has been deprecated. &#xA;Deprecated description: The Fibre Channel frame size, in bytes, that is currently negotiated between the two Ports."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="NegotiatedSpeed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
