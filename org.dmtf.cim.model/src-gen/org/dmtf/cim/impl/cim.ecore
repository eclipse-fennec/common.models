      </eParameters>
      <eParameters name="Synchronization" eType="#//CIM_Synchronized">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_Synchronized REF"/>
          <details key="In" value="false"/>
          <details key="Out" value="true"/>
