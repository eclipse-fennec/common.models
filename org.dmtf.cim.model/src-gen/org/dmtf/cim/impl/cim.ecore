    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="FCPortRateStatistics is the performance rate for the FCPort. The Frame and Byte rates report the average of a counter change per second and the maximum counter change per second over a specified interval, the SampleInterval, which is defined in the parent class, StatisticalData."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="TxFrameRate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
