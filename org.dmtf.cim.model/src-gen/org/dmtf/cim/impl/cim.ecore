      <details key="documentation" value="The ToDirectorySpecification association identifies the target directory for a FileAction. When this association is used, the assumption is that the target directory already exists. This association cannot co-exist with a ToDirectoryAction association, since a FileAction can only involve a single target directory."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="DestinationDirectory" eType="#//CIM_DirectorySpecification">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
