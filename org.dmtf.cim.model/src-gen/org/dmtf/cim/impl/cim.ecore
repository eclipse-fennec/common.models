        <details key="Max" value="1"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The product that has been installed."/>
      </eAnnotations>
    </eStructuralFeatures>
