          <details key="cimType" value="CIM_ZoneSet REF"/>
          <details key="Required" value="true"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A reference to the ZoneSet that the Zone is added to."/>
        </eAnnotations>
      </eParameters>
      <eParameters name="Zone" eType="#//CIM_Zone">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="CIM_Zone REF"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A reference to the Zone that is to be added to the ZoneSet."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
