        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint16[]"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;2&quot;,&quot;3&quot;,&quot;4&quot;,&quot;5&quot;,&quot;6&quot;,&quot;7&quot;,&quot;8&quot;,&quot;9&quot;,&quot;10&quot;]"/>
        <details key="Values" value="[&quot;none&quot;,&quot;GetPhysicalCapacityUsage&quot;,&quot;GetLogicalCapacityUsage&quot;,&quot;GetSystemRatio&quot;,&quot;GetDeduplicationRatio&quot;,&quot;GetReplicationThroughput&quot;,&quot;GetReplicationRatio&quot;,&quot;GetPerformanceStatisticsReadWriteIO&quot;,&quot;GetFCPortStatisticsSRR&quot;,&quot;GetFCPortStatisticsAborts&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="SupportedSyncActions lists the statistical services implemented synchronously. Methods in this list would always return a null for the job output parameter.&#xA;If the value &quot;0&quot; (none) is identified, no other value may be specified.&#xA;Methods identified in this property should not be listed in the SupportedAsyncActions property."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="SupportedAsyncActions"
        unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
