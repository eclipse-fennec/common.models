        </eAnnotations>
      </eParameters>
      <eParameters name="LocalElementRole" unique="false" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
        <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
          <details key="cimType" value="uint16[]"/>
