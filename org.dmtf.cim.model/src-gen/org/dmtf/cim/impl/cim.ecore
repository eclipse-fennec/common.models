        <details key="Key" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Note: The use of this element is deprecated. Deprecated description: The CollectionOfMSEs."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Configuration" eType="#//CIM_Configuration">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
