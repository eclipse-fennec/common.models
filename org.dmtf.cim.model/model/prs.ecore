        <details key="documentation" value="The vendor of the product."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ProductName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="string"/>
