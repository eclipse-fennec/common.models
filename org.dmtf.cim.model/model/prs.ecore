      <details key="override.Dependent.Description" value="The child PRS_Category used for classification."/>
      <details key="keys" value="Antecedent,Dependent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="PRS_CategoryParentChild is used to define classification hierarchies."/>
    </eAnnotations>
  </eClassifiers>
