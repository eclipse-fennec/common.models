  <eClassifiers xsi:type="ecore:EClass" name="PRS_Address" eSuperTypes="#//PRS_ExchangeElement">
    <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
      <details key="Version" value="2.6.0"/>
      <details key="UMLPackagePath" value="PRS::Support"/>
      <details key="keys" value="PRSUniqueName"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Provides address information for PRS_ContactItem."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="AddressType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://schemas.dmtf.org/wbem/cim">
        <details key="cimType" value="uint8"/>
        <details key="ValueMap" value="[&quot;0&quot;,&quot;1&quot;,&quot;2&quot;,&quot;3&quot;,&quot;254&quot;,&quot;255&quot;]"/>
        <details key="Values" value="[&quot;Primary&quot;,&quot;Shipping&quot;,&quot;Billing&quot;,&quot;Service&quot;,&quot;Other&quot;,&quot;Unknown&quot;]"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
