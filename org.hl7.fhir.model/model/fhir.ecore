        <details key="documentation" value="Target or actual group of participants enrolled in study."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="recruitment"/>
