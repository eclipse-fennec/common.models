  <eClassifiers xsi:type="ecore:EClass" name="Appointment" eSuperTypes="#//DomainResource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A booking of a healthcare event among patient(s), practitioner(s), related person(s) and/or device(s) for a specific date/time. This may result in one or more Encounter(s).&#xA;If the element is present, it must have either a @value, an @id, or extensions"/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
