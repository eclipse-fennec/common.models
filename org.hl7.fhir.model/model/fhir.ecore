      <details key="documentation" value="A provider issued list of professional services and products which have been provided, or are to be provided, to a patient which is sent to an insurer for reimbursement.&#xA;If the element is present, it must have either a @value, an @id, or extensions"/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Claim"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
