        <details key="name" value="line"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="city" eType="#//String"
        containment="true" resolveProxies="false">
