        <details key="kind" value="element"/>
        <details key="name" value="quantity"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="expectedSupplyDuration"
        eType="#//Duration" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the period time over which the supplied product is expected to be used, or the length of time the dispense is expected to last."/>
      </eAnnotations>
