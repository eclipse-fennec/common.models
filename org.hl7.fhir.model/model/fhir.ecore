    <eStructuralFeatures xsi:type="ecore:EReference" name="marketingStatus" upperBound="-1"
        eType="#//MarketingStatus" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
