    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The MeasureReport resource contains the results of the calculation of a measure; and optionally a reference to the resources involved in that calculation.&#xA;If the element is present, it must have either a @value, an @id, or extensions"/>
    </eAnnotations>
