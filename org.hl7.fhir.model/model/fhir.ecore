        <details key="documentation" value="Refers to a copyright statement that applies to the&#xA;    link's context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="createForm" value="18" literal="create-form">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The target IRI points to a resource where a submission form can be obtained."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="current" value="19">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource containing the most recent&#xA;      item(s) in a collection of resources."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="describedby" value="20">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource providing information about the&#xA;      link's context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="describes" value="21">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship A 'describes' B asserts that&#xA;      resource A provides a description of resource B. There are no&#xA;      constraints on the format or representation of either A or B,&#xA;      neither are there any further constraints on either resource."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="disclosure" value="22">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a list of patent disclosures made with respect to &#xA;      material for which 'disclosure' relation is specified."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="dnsPrefetch" value="23" literal="dns-prefetch">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Used to indicate an origin that will be used to fetch required &#xA;      resources for the link context, and that the user agent ought to resolve &#xA;      as early as possible."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="duplicate" value="24">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource whose available representations&#xA;      are byte-for-byte identical with the corresponding representations of&#xA;      the context IRI."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="edit" value="25">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that can be used to edit the&#xA;      link's context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="editForm" value="26" literal="edit-form">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The target IRI points to a resource where a submission form for&#xA;      editing associated resource can be obtained."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="editMedia" value="27" literal="edit-media">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that can be used to edit media&#xA;      associated with the link's context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="enclosure" value="28">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies a related resource that is potentially&#xA;      large and might require special handling."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="external" value="29">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that is not part of the same site as the current context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="first" value="30">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An IRI that refers to the furthest preceding resource&#xA;    in a series of resources."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="glossary" value="31">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a glossary of terms."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="help" value="32">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to context-sensitive help."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="hosts" value="33">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource hosted by the server indicated by&#xA;      the link context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="hub" value="34">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a hub that enables registration for&#xA;    notification of updates to the context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="icon" value="35">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to an icon representing the link's context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="index" value="36">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to an index."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalAfter" value="37">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that ends before the beginning of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalBefore" value="38">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins after the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalContains" value="39">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins after the beginning of the time interval associated with the context resource, and ends before the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalDisjoint" value="40">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins after the end of the time interval associated with the context resource, or ends before the beginning of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalDuring" value="41">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins before the beginning of the time interval associated with the context resource, and ends after the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalEquals" value="42">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval whose beginning coincides with the beginning of the time interval associated with the context resource, and whose end coincides with the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalFinishedBy" value="43">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins after the beginning of the time interval associated with the context resource, and whose end coincides with the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalFinishes" value="44">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins before the beginning of the time interval associated with the context resource, and whose end coincides with the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalIn" value="45">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins before or is coincident with the beginning of the time interval associated with the context resource, and ends after or is coincident with the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalMeets" value="46">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval whose beginning coincides with the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalMetBy" value="47">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval whose end coincides with the beginning of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalOverlappedBy" value="48">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins before the beginning of the time interval associated with the context resource, and ends after the beginning of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalOverlaps" value="49">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval that begins before the end of the time interval associated with the context resource, and ends after the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalStartedBy" value="50">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval whose beginning coincides with the beginning of the time interval associated with the context resource, and ends before the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="intervalStarts" value="51">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="refers to a resource associated with a time interval whose beginning coincides with the beginning of the time interval associated with the context resource, and ends after the end of the time interval associated with the context resource"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="item" value="52">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The target IRI points to a resource that is a member of the collection represented by the context IRI."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="last" value="53">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An IRI that refers to the furthest following resource&#xA;      in a series of resources."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="latestVersion" value="54" literal="latest-version">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Points to a resource containing the latest (e.g.,&#xA;      current) version of the context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="license" value="55">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a license associated with this context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="linkset" value="56">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The link target of a link with the &quot;linkset&quot; relation&#xA;      type provides a set of links, including links in which the link&#xA;      context of the link participates.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="lrdd" value="57">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to further information about the link's context,&#xA;      expressed as a LRDD (&quot;Link-based Resource Descriptor Document&quot;)&#xA;      resource.  See  for information about&#xA;      processing this relation type in host-meta documents. When used&#xA;      elsewhere, it refers to additional links and other metadata.&#xA;      Multiple instances indicate additional LRDD resources. LRDD&#xA;      resources MUST have an &quot;application/xrd+xml&quot; representation, and&#xA;      MAY have others."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="manifest" value="58">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Links to a manifest file for the context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="maskIcon" value="59" literal="mask-icon">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a mask that can be applied to the icon for the context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="mediaFeed" value="60" literal="media-feed">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a feed of personalised media recommendations relevant to the link context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="memento" value="61">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Target IRI points to a Memento, a fixed resource that will not change state anymore."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="micropub" value="62">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Links to the context's Micropub endpoint."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="modulepreload" value="63">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a module that the user agent is to preemptively fetch and store for use in the current context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="monitor" value="64">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that can be used to monitor changes in an HTTP resource.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="monitorGroup" value="65" literal="monitor-group">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that can be used to monitor changes in a specified group of HTTP resources.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="next" value="66">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates that the link's context is a part of a series, and&#xA;      that the next in the series is the link target.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="nextArchive" value="67" literal="next-archive">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to the immediately following archive resource."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="nofollow" value="68">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates that the context’s original author or publisher does not endorse the link target."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="noopener" value="69">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates that any newly created top-level browsing context which results from following the link will not be an auxiliary browsing context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="noreferrer" value="70">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates that no referrer information is to be leaked when following the link."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="opener" value="71">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates that any newly created top-level browsing context which results from following the link will be an auxiliary browsing context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="openid2LocalId" value="72" literal="openid2.local_id">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to an OpenID Authentication server on which the context relies for an assertion that the end user controls an Identifier."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="openid2Provider" value="73" literal="openid2.provider">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource which accepts OpenID Authentication protocol messages for the context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="original" value="74">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Target IRI points to an Original Resource."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="P3Pv1" value="75">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a P3P privacy policy for the context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="payment" value="76">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates a resource where payment is accepted."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="pingback" value="77">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Gives the address of the pingback resource for the link context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="preconnect" value="78">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Used to indicate an origin that will be used to fetch required &#xA;      resources for the link context. Initiating an early connection, which &#xA;      includes the DNS lookup, TCP handshake, and optional TLS negotiation, &#xA;      allows the user agent to mask the high latency costs of establishing a &#xA;      connection."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="predecessorVersion" value="79" literal="predecessor-version">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Points to a resource containing the predecessor&#xA;      version in the version history.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="prefetch" value="80">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The prefetch link relation type is used to identify a resource &#xA;      that might be required by the next navigation from the link context, and &#xA;      that the user agent ought to fetch, such that the user agent can deliver a &#xA;      faster response once the resource is requested in the future."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="preload" value="81">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that should be loaded early in the &#xA;      processing of the link's context, without blocking rendering."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="prerender" value="82">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Used to identify a resource that might be required by the next &#xA;      navigation from the link context, and that the user agent ought to fetch &#xA;      and execute, such that the user agent can deliver a faster response once &#xA;      the resource is requested in the future."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="prev" value="83">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates that the link's context is a part of a series, and&#xA;      that the previous in the series is the link target.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="preview" value="84">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that provides a preview of the link's context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="previous" value="85">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to the previous resource in an ordered series&#xA;      of resources.  Synonym for &quot;prev&quot;."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="prevArchive" value="86" literal="prev-archive">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to the immediately preceding archive resource."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="privacyPolicy" value="87" literal="privacy-policy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a privacy policy associated with the link's context."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="profile" value="88">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifying that a resource representation conforms&#xA;to a certain profile, without affecting the non-profile semantics&#xA;of the resource representation."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="publication" value="89">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Links to a publication manifest. A manifest represents &#xA;      structured information about a publication, such as informative metadata, &#xA;      a list of resources, and a default reading order."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="related" value="90">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies a related resource."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="restconf" value="91">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the root of RESTCONF API as configured on this HTTP server.&#xA;      The &quot;restconf&quot; relation defines the root of the API defined in RFC8040.&#xA;      Subsequent revisions of RESTCONF will use alternate relation values to support &#xA;      protocol versioning."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="replies" value="92">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies a resource that is a reply to the context&#xA;      of the link.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ruleinput" value="93">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The resource identified by the link target provides an input value to an &#xA;    instance of a rule, where the resource which represents the rule instance is &#xA;    identified by the link context.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="search" value="94">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a resource that can be used to search through&#xA;      the link's context and related resources."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="section" value="95">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refers to a section in a collection of resources."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="self" value="96">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Conveys an identifier for the link's context.&#xA;    "/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="service" value="97">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates a URI that can be used to retrieve a&#xA;      service document."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="serviceDesc" value="98" literal="service-desc">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies service description for the context that&#xA;      is primarily intended for consumption by machines."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="serviceDoc" value="99" literal="service-doc">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies service documentation for the context that&#xA;      is primarily intended for human consumption."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="serviceMeta" value="100" literal="service-meta">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies general metadata for the context that is&#xA;      primarily intended for consumption by machines."/>
