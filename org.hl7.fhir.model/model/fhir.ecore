    <eLiterals name="DELETEMULTIPLEMATCHES" literal="DELETE_MULTIPLE_MATCHES">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Error: Multiple matches exist for the conditional delete&#xA;Fout: er is meer dan één resultaat voor de conditionele delete"/>
