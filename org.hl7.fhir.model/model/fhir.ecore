    <eStructuralFeatures xsi:type="ecore:EReference" name="claimResponse" eType="#//ClaimResponse"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This resource provides the adjudication details from the processing of a Claim resource."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
