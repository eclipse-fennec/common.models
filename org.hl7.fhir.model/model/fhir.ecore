        <details key="documentation" value="Sponsors, collaborators, and other parties."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="associatedParty"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="progressStatus" upperBound="-1"
        eType="#//ResearchStudyProgressStatus" containment="true" resolveProxies="false">
