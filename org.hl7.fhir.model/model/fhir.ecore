  <eClassifiers xsi:type="ecore:EClass" name="Measure" eSuperTypes="#//MetadataResource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The Measure resource provides the definition of a quality measure.&#xA;If the element is present, it must have either a @value, an @id, or extensions"/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
