        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The stage in the progression of a therapy from initial experimental use in humans in clinical trials to post-market evaluation."/>
      </eAnnotations>
