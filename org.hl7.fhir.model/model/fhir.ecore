        eType="#//NutritionOrder" volatile="true" transient="true" derived="true"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A request to supply a diet, formula feeding (enteral) or oral nutritional supplement to a patient/resident."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="NutritionOrder"/>
        <details key="namespace" value="##targetNamespace"/>
